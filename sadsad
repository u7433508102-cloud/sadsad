local function packetWallClear(origin, targetPos, targetChar)
    if not targetChar or typeof(origin) ~= "Vector3" or typeof(targetPos) ~= "Vector3" then return true end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, targetChar}
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    if Workspace:Raycast(origin, targetPos-origin, params) then return false end
    local pingSec = getPingMs()/1000
    local hrp = getRootPart(LocalPlayer)
    if hrp and pingSec > 0 then
        local vel = hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.new()
        local shifted = origin - vel*pingSec
        if Workspace:Raycast(shifted, targetPos-shifted, params) then return false end
    end
    return true
end

local function isWallbangActive() return Config.Wallbang and Config.Wallbang.Enabled == true end

local function isPlayerKnockedOrKO(player)
    if not Config.Settings.KnockCheck then return false end
    if not player.Character then return true end
    local h = player.Character:FindFirstChild("Humanoid")
    if h and h.Health <= 0 then return true end
    local be = player.Character:FindFirstChild("BodyEffects")
    if be then
        local ko = be:FindFirstChild("K.O"); if ko and ko.Value == true then return true end
        local kn = be:FindFirstChild("Knocked"); if kn and kn.Value == true then return true end
    end
    return false
end

local function isSelfKnocked()
    if LocalPlayer.Character then
        local be = LocalPlayer.Character:FindFirstChild("BodyEffects")
        if be then
            local ko = be:FindFirstChild("K.O"); if ko and ko.Value == true then return true end
            local kn = be:FindFirstChild("Knocked"); if kn and kn.Value == true then return true end
        end
    end
    return false
end

local function canSeeTarget(part)
    if isWallbangActive() then return true end
    if not Config.Settings.VisibleCheck then return true end
    if not part or not part.Parent then return false end
    local ch = part.Parent
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local st = hum:GetState()
    local airborne = (st==Enum.HumanoidStateType.Jumping or st==Enum.HumanoidStateType.Freefall or st==Enum.HumanoidStateType.FallingDown)
    local root = ch:FindFirstChild("HumanoidRootPart")
    local velY = root and math.abs((root.AssemblyLinearVelocity or root.Velocity or Vector3.new()).Y) or 0
    if (airborne or velY > 8) and isLocking then return true end
    local origin = Camera.CFrame.Position
    if Config.AdvancedAim.PacketWallClear then return packetWallClear(origin, part.Position, ch) end
    local dir = part.Position-origin
    local p = RaycastParams.new()
    p.FilterDescendantsInstances = {LocalPlayer.Character, ch}
    p.FilterType = Enum.RaycastFilterType.Exclude; p.IgnoreWater = true
    local hit = Workspace:Raycast(origin, dir, p)
    return hit == nil or hit.Instance:IsDescendantOf(ch)
end

local function findVisiblePointOnPart(part, origin, mouseScreen, camera, requireVisible)
    if not (part and part:IsA("BasePart") and typeof(origin) == "Vector3") then return nil end
    local adv = Config.AdvancedAim
    if not adv or not adv.MultiPoint then return part.Position end
    local now = os.clock(); local cache = MultiPointCache
    if now-cache.sweep > 2 then
        cache.sweep=now
        for k,e in pairs(cache.m) do if now-e.t > 0.5 or not k.Parent then cache.m[k]=nil end end
    end
    local cached = cache.m[part]
    if cached then
        local failed = cached.pt == false
        local tD = failed and 3 or 0.5
        local tT = failed and 0.066 or 0.008
        if (cached.o-origin).Magnitude < tD and (now-cached.t) <= tT then return failed and nil or cached.pt end
    end
    local cam = camera or Camera; local camPos = cam.CFrame.Position
    local partCFrame = part.CFrame; local size = part.Size
    if part.Name=="HumanoidRootPart" and (size.X>3 or size.Y>3 or size.Z>3) then size=Vector3.new(2,2,1) end
    local inset = 0.05
    local extents = Vector3.new(math.max(size.X*0.5*(1-inset),0.01),math.max(size.Y*0.5*(1-inset),0.01),math.max(size.Z*0.5*(1-inset),0.01))
    local targetScreen = mouseScreen or Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local function rayClear(f,t)
        local d = t-f; if d.Magnitude < 0.001 then return true end
        local p = RaycastParams.new()
        p.FilterDescendantsInstances={LocalPlayer.Character,part.Parent}
        p.FilterType=Enum.RaycastFilterType.Exclude; p.IgnoreWater=true
        local h = Workspace:Raycast(f,d,p)
        return h==nil or h.Instance:IsDescendantOf(part.Parent)
    end
    local ray = cam:ViewportPointToRay(targetScreen.X, targetScreen.Y)
    local toPart = part.Position-ray.Origin
    local projLen = toPart:Dot(ray.Direction)
    local projPoint = ray.Origin+ray.Direction*projLen
    local localPt = partCFrame:PointToObjectSpace(projPoint)
    local clamped = Vector3.new(math.clamp(localPt.X,-extents.X,extents.X),math.clamp(localPt.Y,-extents.Y,extents.Y),math.clamp(localPt.Z,-extents.Z,extents.Z))
    local cand = partCFrame*clamped
    if rayClear(origin, cand) then cache.m[part]={o=origin,pt=cand,t=now}; return cand end
    if requireVisible then cache.m[part]={o=origin,pt=false,t=now}; return nil end
    local quality = adv.MultiPointQuality or 9
    local axes = {Vector3.new(1,0,0),Vector3.new(0,1,0),Vector3.new(0,0,1)}
    local best, bestScr = nil, math.huge
    for ai=1,3 do
        local axis = axes[ai]
        local sign = ((camPos-part.Position):Dot(partCFrame:VectorToWorldSpace(axis))>=0) and 1 or -1
        for oy=-1,1 do for oz=-1,1 do
            local skip = false
            if quality==1 and not (oy==0 and oz==0) then skip=true end
            if quality==9 and oy==0 and oz==0 then skip=true end
            if not skip then
                local eX,eY,eZ = extents.X, extents.Y, extents.Z
                local s
                if ai==1 then s=partCFrame*Vector3.new(eX*sign,eY*oy*0.85,eZ*oz*0.85)
                elseif ai==2 then s=partCFrame*Vector3.new(eX*oy*0.85,eY*sign,eZ*oz*0.85)
                else s=partCFrame*Vector3.new(eX*oy*0.85,eY*oz*0.85,eZ*sign) end
                local scr, on = cam:WorldToViewportPoint(s)
                if on and scr.Z > 0 then
                    local dx,dy = targetScreen.X-scr.X, targetScreen.Y-scr.Y
                    local d2 = dx*dx+dy*dy
                    if d2 < bestScr and rayClear(origin,s) then bestScr=d2; best=s end
                end
            end
        end end
    end
    if best then cache.m[part]={o=origin,pt=best,t=now}; return best end
    cache.m[part]={o=origin,pt=false,t=now}; return nil
end

local function getClosestBodyPart(character)
    local parts = {
        character:FindFirstChild("Head"),character:FindFirstChild("UpperTorso"),character:FindFirstChild("HumanoidRootPart"),
        character:FindFirstChild("LowerTorso"),character:FindFirstChild("LeftUpperArm"),character:FindFirstChild("RightUpperArm"),
        character:FindFirstChild("LeftLowerArm"),character:FindFirstChild("RightLowerArm"),character:FindFirstChild("LeftHand"),
        character:FindFirstChild("RightHand"),character:FindFirstChild("LeftUpperLeg"),character:FindFirstChild("RightUpperLeg"),
        character:FindFirstChild("LeftLowerLeg"),character:FindFirstChild("RightLowerLeg"),character:FindFirstChild("LeftFoot"),
        character:FindFirstChild("RightFoot"),character:FindFirstChild("Torso"),character:FindFirstChild("Left Arm"),
        character:FindFirstChild("Right Arm"),character:FindFirstChild("Left Leg"),character:FindFirstChild("Right Leg"),
    }
    local sc = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local mp = Vector2.new(Mouse.X, Mouse.Y)
    local origin = Camera.CFrame.Position
    local bp, bpt, bs = nil, nil, math.huge
    for _, part in pairs(parts) do
        if part then
            local pt = findVisiblePointOnPart(part, origin, mp, Camera, false) or part.Position
            local sp, on = Camera:WorldToViewportPoint(pt)
            if on then
                local d = (Vector2.new(sp.X,sp.Y)-sc).Magnitude
                if d < bs then bs=d; bp=part; bpt=pt end
            end
        end
    end
    if bp then return bpt, bp end
    return nil
end

local function isTargetInFOV(part)
    if not Config.SilentAimFOV.Enabled then return true end
    if not part or not part.Parent then return false end
    local sp, on = Camera:WorldToViewportPoint(part.Position)
    if not on then return false end
    local sc = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    return (Vector2.new(sp.X,sp.Y)-sc).Magnitude <= Config.SilentAimFOV.Radius
end

local function findClosestTarget()
    local bestT, bestP, bestD = nil, nil, math.huge
    local fov = Config.SilentAimFOV
    local mp = Vector2.new(Mouse.X, Mouse.Y)
    local sc = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if not isPlayerKnockedOrKO(p) then
                local tp, rp
                if Config.SilentAim.HitPart == 'Closest Part' then
                    rp, tp = getClosestBodyPart(p.Character)
                else
                    tp = p.Character:FindFirstChild(Config.SilentAim.HitPart)
                    if tp then rp = findVisiblePointOnPart(tp, Camera.CFrame.Position, mp, Camera, false) or tp.Position end
                end
                if tp and canSeeTarget(tp) then
                    local pt = rp or tp.Position
                    local sp, on = Camera:WorldToViewportPoint(pt)
                    if on then
                        if fov.Enabled then
                            if (Vector2.new(sp.X,sp.Y)-sc).Magnitude > fov.Radius then continue end
                        end
                        local d = (Vector2.new(sp.X,sp.Y)-mp).Magnitude
                        if d < bestD then bestD=d; bestT=tp; bestP=pt end
                    end
                end
            end
        end
    end
    if bestT then currentTargetPoint = bestP end
    return bestT
end

local function findAimAssistTarget()
    local mp = Vector2.new(Mouse.X, Mouse.Y)
    local best, bestD = nil, math.huge
    local fov = Config.CameraLockFOV
    local sc = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if not isPlayerKnockedOrKO(p) then
                local part = p.Character:FindFirstChild("HumanoidRootPart")
                if part and canSeeTarget(part) then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        if fov.Enabled then
                            if (Vector2.new(sp.X,sp.Y)-sc).Magnitude > fov.Radius then continue end
                        end
                        local d = (Vector2.new(sp.X,sp.Y)-mp).Magnitude
                        if d < bestD then bestD=d; best=p end
                    end
                end
            end
        end
    end
    return best
end

local function getPredictedPosition(part, config)
    if not config.UsePrediction then return part.Position end
    local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.new(0,0,0)
    local pr = config.Prediction
    local pred
    if type(pr)=="table" then
        pred = part.Position + Vector3.new(vel.X*(pr.X or 0.133), vel.Y*(pr.Y or 0.133), vel.Z*(pr.Z or 0.133))
    else
        if pr==0 then pr=0.1245 end
        pred = part.Position + vel*pr
    end
    if Config.AdvancedAim.GaussianRandom then
        local s = Config.AdvancedAim.GaussianSpread or 0.6
        pred = pred + Vector3.new(gaussianRandom(0,s),gaussianRandom(0,s),gaussianRandom(0,s))
    end
    return pred
end

local function applyAimAssist()
    if not aimAssistEnabled then return end
    if not Config.CameraLock.Enabled then return end
    if isSelfKnocked() then aimAssistTarget = nil; return end
    if aimAssistTarget then
        local ch = aimAssistTarget.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 or isPlayerKnockedOrKO(aimAssistTarget) then aimAssistTarget = nil end
    end
    if not aimAssistTarget then aimAssistTarget = findAimAssistTarget() end
    if not aimAssistTarget then return end
    local part = aimAssistTarget.Character:FindFirstChild("HumanoidRootPart")
    if not part then return end
    local tp = getPredictedPosition(part, Config.CameraLock)
    local camCF = Camera.CFrame
    local tCF = CFrame.new(camCF.Position, tp)
    local sm = Config.CameraLock.Smoothing
    Camera.CFrame = camCF:Lerp(tCF, math.min(1/sm, 1))
end

