-- UI (xanax.wtf style)
-- ══════════════════════════════════════════════════════════════
if Config['UI'] and Config['UI']['Enabled'] then
    local UI = Config['UI']
    local gui = Instance.new("ScreenGui")
    gui.Name = "XanaxUI"; gui.Parent = game.CoreGui
    gui.ResetOnSpawn = false; gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.IgnoreGuiInset = true

    local lbl = Instance.new("TextLabel")
    lbl.Name = "MainText"; lbl.Parent = gui
    lbl.AnchorPoint = Vector2.new(0.5, 1)
    lbl.Position = UDim2.new(0.5, UI['Position']['X'] or 0, 1, UI['Position']['Y'] or -180)
    lbl.Size = UDim2.new(0, 600, 0, 300)
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Center
    lbl.TextYAlignment = Enum.TextYAlignment.Bottom
    lbl.Font = Enum.Font.GothamBold
    lbl.RichText = true
    lbl.TextSize = UI['TextSize'] or 18
    lbl.TextStrokeTransparency = 1
    lbl.Visible = true

    local function rgb(c) return string.format("rgb(%d,%d,%d)", c.R*255, c.G*255, c.B*255) end

    local function getTargetName()
        if currentTarget then
            local ch = currentTarget.Parent
            if ch then
                local p = Players:GetPlayerFromCharacter(ch)
                if p then return p.DisplayName ~= "" and p.DisplayName or p.Name end
            end
        end
        return nil
    end

    local function getTargetDistance()
        if currentTarget then
            local ch = currentTarget.Parent
            if ch then
                local rp = ch:FindFirstChild("HumanoidRootPart")
                if rp then return math.floor((Camera.CFrame.Position - rp.Position).Magnitude) end
            end
        end
        return nil
    end

    local function featureLine(name, tname, tdist)
        if tname and tdist then
            return string.format('%s <font color="%s">(%s - %d)</font>',
                name, rgb(UI['TargetColor']), tname, tdist)
        end
        return name
    end

    table.insert(connections, RunService.RenderStepped:Connect(function()
        local lines = {}
        lines[#lines+1] = string.format('<font size="%d" color="%s"><b>%s</b></font>',
            UI['BrandSize'] or 20, rgb(UI['BrandColor']), UI['Brand'] or 'xanax.wtf')
        if UI['Subtitle'] and UI['Subtitle'] ~= "" then
            lines[#lines+1] = string.format('<font size="%d" color="%s">%s</font>',
                UI['SubtitleSize'] or 16, rgb(UI['SubtitleColor']), UI['Subtitle'])
        end

        local tname = getTargetName()
        local tdist = getTargetDistance()

        if UI['ShowSilentAim'] and Config['Silent Aim']['Enabled'] and isLocking and currentTarget and tname then
            lines[#lines+1] = string.format('<font color="%s">%s</font>', rgb(UI['FeatureColor']), featureLine("Silent Aim", tname, tdist))
        end
        if UI['ShowAimAssist'] and Config['Camera Lock']['Enabled'] and aimAssistEnabled and aimAssistTarget and aimAssistTarget.Character then
            local rp = aimAssistTarget.Character:FindFirstChild("HumanoidRootPart")
            if rp then
                local d = math.floor((Camera.CFrame.Position - rp.Position).Magnitude)
                local n = aimAssistTarget.DisplayName ~= "" and aimAssistTarget.DisplayName or aimAssistTarget.Name
                lines[#lines+1] = string.format('<font color="%s">%s</font>', rgb(UI['FeatureColor']), featureLine("Aim Assist", n, d))
            end
        end
        if UI['ShowTriggerBot'] and Config['Trigger Bot']['Enabled'] and triggerEnabled and tname then
            lines[#lines+1] = string.format('<font color="%s">%s</font>', rgb(UI['FeatureColor']), featureLine("Trigger Bot", tname, tdist))
        end
        if UI['ShowWalkSpeed'] and Config['Speed']['Enabled'] and SpeedEnabled then
            lines[#lines+1] = string.format('<font color="%s">Walk Speed</font>', rgb(UI['FeatureColor']))
        end
        if UI['ShowJumpPower'] and Config['Super Jump']['Enabled'] then
            if UserInputService:IsKeyDown(Enum.KeyCode[Config['Keybinds']['Super Jump']]) then
                lines[#lines+1] = string.format('<font color="%s">Jump Power</font>', rgb(UI['FeatureColor']))
            end
        end
        lbl.Text = table.concat(lines, "\n")
    end))
end

