local function randomOffsetSafe()
    local dr = Config['Desync']['Range'] or 1e9
    local mnY = Config['Desync']['Min Y'] or 100
    local mxY = Config['Desync']['Max Y'] or 50000
    return Vector3.new((math.random()*2-1)*dr, mnY + math.random()*(mxY-mnY), (math.random()*2-1)*dr)
end

function stopDesync()
    if not desyncActive then return end
    desyncActive = false
    if desyncRoot and desyncOriginalCFrame then desyncRoot.CFrame = desyncOriginalCFrame end
    if desyncHumanoid then desyncHumanoid.AutoRotate = true; desyncHumanoid.PlatformStand = false end
    desyncRoot = nil; desyncOriginalCFrame = nil; desyncHumanoid = nil
    if desyncCircle then desyncCircle.Visible = false end
    if desyncLine then desyncLine.Visible = false end
end

local function startDesync()
    if desyncActive then return end
    local ch = LocalPlayer.Character
    local root = getRootPart(LocalPlayer)
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    desyncRoot = root; desyncHumanoid = hum; desyncOriginalCFrame = root.CFrame
    if not desyncCircle then
        desyncCircle = Drawing.new("Circle"); desyncCircle.Thickness = 2
        desyncCircle.Color = Color3.fromRGB(255,0,0); desyncCircle.Radius = 8
        desyncCircle.Filled = true; desyncCircle.Visible = false
    end
    if not desyncLine then
        desyncLine = Drawing.new("Line"); desyncLine.Thickness = 2
        desyncLine.Color = Color3.fromRGB(255,0,0); desyncLine.Visible = false
    end
    hum.AutoRotate = false; hum.PlatformStand = true
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    desyncActive = true
    table.insert(connections, RunService.Heartbeat:Connect(function()
        if not desyncActive or not desyncRoot or not desyncRoot.Parent then stopDesync(); return end
        desyncRoot.CFrame = desyncOriginalCFrame * CFrame.new(randomOffsetSafe())
        pcall(function() desyncRoot.AssemblyLinearVelocity = Vector3.new(0,0,0); desyncRoot.Velocity = Vector3.new(0,0,0) end)
        if desyncHumanoid and desyncHumanoid.Health > 0 then
            pcall(function() desyncHumanoid:ChangeState(Enum.HumanoidStateType.Physics) end)
        end
    end))
    table.insert(connections, RunService.RenderStepped:Connect(function()
        if not desyncActive or not desyncOriginalCFrame then
            if desyncCircle then desyncCircle.Visible = false end
            if desyncLine then desyncLine.Visible = false end
            return
        end
        local op = desyncOriginalCFrame.Position
        local sp, on = Camera:WorldToViewportPoint(op)
        if on then desyncCircle.Position = Vector2.new(sp.X, sp.Y); desyncCircle.Visible = true
        else desyncCircle.Visible = false end
        if desyncRoot and desyncRoot.Parent then
            local cs, co = Camera:WorldToViewportPoint(desyncRoot.Position)
            local os2, oo = Camera:WorldToViewportPoint(op)
            if co and oo then
                desyncLine.From = Vector2.new(cs.X, cs.Y); desyncLine.To = Vector2.new(os2.X, os2.Y); desyncLine.Visible = true
            else desyncLine.Visible = false end
        else desyncLine.Visible = false end
    end))
end

local function toggleDesync()
    if desyncActive then stopDesync()
    else
        if not Config['Desync']['Enabled'] then return end
        startDesync()
    end
end

local function startSpectate()
    if spectateActive then return end
    local t = findClosestPlayer()
    if not t then return end
    spectateTarget = t; spectateActive = true
    Camera.CameraSubject = t.Character
    task.spawn(function()
        while spectateActive and spectateTarget do
            local p = spectateTarget
            if not p.Parent then break end
            if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
                p.CharacterAdded:Wait()
                if spectateActive and spectateTarget == p then Camera.CameraSubject = p.Character end
            end
            task.wait(1)
        end
    end)
end

function stopSpectate()
    if not spectateActive then return end
    spectateActive = false; spectateTarget = nil
    if LocalPlayer.Character then Camera.CameraSubject = LocalPlayer.Character end
end

local function toggleSpectate()
    if spectateActive then stopSpectate() else startSpectate() end
end

