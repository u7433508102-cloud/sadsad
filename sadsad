-- ========== TOOL MODIFIER – NO DELAY, INF AMMO, NO BULLET DROP ==========
local function modifyTool(tool)
    if not tool then return end
    if not Config['Rapid Fire']['Enabled'] then return end

    -- Check weapon whitelist
    if Config['Rapid Fire']['Specific Weapons']['Enabled'] then
        local valid = false
        for _, wName in pairs(Config['Rapid Fire']['Specific Weapons']['Weapons']) do
            if tool.Name == wName then
                valid = true
                break
            end
        end
        if not valid then return end
    end

    -- === 1. Remove fire rate delay ===
    local fireRateProps = {"FireRate", "Rate", "Cooldown", "FireCooldown", "ShotCooldown", "ReloadTime", "RecoilCooldown"}
    for _, prop in pairs(fireRateProps) do
        local val = tool:FindFirstChild(prop)
        if val then
            if val:IsA("NumberValue") then
                val.Value = 0
            elseif val:IsA("NumberValue") then
                val.Value = 0
            else
                -- try as attribute or property
                pcall(function()
                    tool[prop] = 0
                end)
            end
        end
        -- also check inside a "Configuration" or "GunConfig" folder
        local configFolder = tool:FindFirstChild("Configuration") or tool:FindFirstChild("GunConfig")
        if configFolder then
            local val2 = configFolder:FindFirstChild(prop)
            if val2 and val2:IsA("NumberValue") then
                val2.Value = 0
            end
        end
    end

    -- Override CanUse to always return true (bypass cooldown)
    local canUse = tool:FindFirstChild("CanUse")
    if canUse and canUse:IsA("BoolValue") then
        canUse.Value = true
    end
    -- Also try to set the tool's "Enabled" property if exists
    pcall(function()
        tool.Enabled = true
    end)

    -- === 2. Infinite ammo ===
    local ammoProps = {"Ammo", "CurrentAmmo", "Magazine", "StoredAmmo", "ReserveAmmo"}
    for _, prop in pairs(ammoProps) do
        local val = tool:FindFirstChild(prop)
        if val and val:IsA("NumberValue") then
            val.Value = 9e9
            -- hook changed to keep it filled
            val:GetPropertyChangedSignal("Value"):Connect(function()
                val.Value = 9e9
            end)
        end
        -- check config folder
        local configFolder = tool:FindFirstChild("Configuration") or tool:FindFirstChild("GunConfig")
        if configFolder then
            local val2 = configFolder:FindFirstChild(prop)
            if val2 and val2:IsA("NumberValue") then
                val2.Value = 9e9
                val2:GetPropertyChangedSignal("Value"):Connect(function()
                    val2.Value = 9e9
                end)
            end
        end
    end

    -- === 3. Bullet drop removal ===
    local dropProps = {"BulletDrop", "Gravity", "ProjectileGravity", "Drop", "Falloff"}
    for _, prop in pairs(dropProps) do
        local val = tool:FindFirstChild(prop)
        if val then
            if val:IsA("NumberValue") then
                val.Value = 0
            else
                pcall(function()
                    tool[prop] = 0
                end)
            end
        end
        local configFolder = tool:FindFirstChild("Configuration") or tool:FindFirstChild("GunConfig")
        if configFolder then
            local val2 = configFolder:FindFirstChild(prop)
            if val2 and val2:IsA("NumberValue") then
                val2.Value = 0
            end
        end
    end

    -- Also hook bullet creation to reset gravity on projectiles
    local handle = tool:FindFirstChild("Handle")
    if handle then
        handle.ChildAdded:Connect(function(child)
            if child:IsA("Part") and child.Name:lower():find("bullet") or child.Name:lower():find("projectile") then
                child.Gravity = 0
                child.AssemblyLinearVelocity = child.AssemblyLinearVelocity * Vector3.new(1,0,1) -- remove Y component (flatten trajectory)
            end
        end)
    end
end

