-- INPUT
-- ══════════════════════════════════════════════════════════════
table.insert(connections, UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local kb = Config['Keybinds']
    if input.KeyCode == Enum.KeyCode[kb['Target Lock']['Key']] then
        if kb['Target Lock']['Mode'] == 'Toggle' then
            if Config['Settings']['Target Aim'] then
                if isLocking then isLocking = false; currentTarget = nil
                else
                    local t = findClosestTarget()
                    if t then currentTarget = t; isLocking = true end
                end
            else isLocking = not isLocking end
        elseif kb['Target Lock']['Mode'] == 'Hold' then
            if Config['Settings']['Target Aim'] then
                local t = findClosestTarget()
                if t then currentTarget = t; isLocking = true end
            else isLocking = true end
        end
    end
    if input.KeyCode == Enum.KeyCode[kb['Trigger Bot']['Key']] then
        if kb['Trigger Bot']['Mode'] == 'Toggle' then triggerEnabled = not triggerEnabled
        elseif kb['Trigger Bot']['Mode'] == 'Hold' then triggerEnabled = true end
    end
    if input.KeyCode == Enum.KeyCode[kb['Speed']] then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            if not SpeedEnabled then SpeedEnabled = true
            else hum.WalkSpeed = 16; SpeedEnabled = false end
        end
    end
    if input.KeyCode == Enum.KeyCode[kb['ESP']] then Config['ESP']['Enabled'] = not Config['ESP']['Enabled'] end
    if input.KeyCode == Enum.KeyCode[kb['Camera Lock']] then
        if Config['Camera Lock']['Enabled'] then
            aimAssistEnabled = not aimAssistEnabled
            if not aimAssistEnabled then aimAssistTarget = nil end
        end
    end
    if input.KeyCode == Enum.KeyCode[kb['Desync']] then toggleDesync() end
    if input.KeyCode == Enum.KeyCode[kb['Spectate']] then toggleSpectate() end
    if input.KeyCode == Enum.KeyCode[kb['Bullet TP']] then bulletTPActive = not bulletTPActive end
    if input.KeyCode == Enum.KeyCode[Config['Infinite Range']['Key']] then infRangeActive = not infRangeActive end
    if input.KeyCode == Enum.KeyCode.RightControl then
        if shared.__XANAX_UNLOAD then shared.__XANAX_UNLOAD() end
    end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    local kb = Config['Keybinds']
    if input.KeyCode == Enum.KeyCode[kb['Target Lock']['Key']] and kb['Target Lock']['Mode'] == 'Hold' then
        isLocking = false; currentTarget = nil
    end
    if input.KeyCode == Enum.KeyCode[kb['Trigger Bot']['Key']] and kb['Trigger Bot']['Mode'] == 'Hold' then
        triggerEnabled = false
    end
end))

-- ══════════════════════════════════════════════════════════════
-- UNLOAD
-- ══════════════════════════════════════════════════════════════
function shared.__XANAX_UNLOAD()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    connections = {}
    stopDesync()
    stopSpectate()
    bulletTPActive = false
    if getgenv().XanaxSetAutoStomp then getgenv().XanaxSetAutoStomp(false) end
    if desyncCircle then desyncCircle:Remove(); desyncCircle = nil end
    if desyncLine then desyncLine:Remove(); desyncLine = nil end
    if silentFovCircle then silentFovCircle:Remove(); silentFovCircle = nil end
    if camlockFovCircle then camlockFovCircle:Remove(); camlockFovCircle = nil end
    if snaplineDrawing then snaplineDrawing:Remove(); snaplineDrawing = nil end
    for _, esp in pairs(espLabels) do
        esp.nameTag:Remove(); esp.Distance:Remove(); esp.Weapon:Remove()
        esp.HealthText:Remove(); esp.Flag:Remove()
        esp.HeadDot:Remove(); esp.HeadDotOutline:Remove()
        for i = 1, 4 do
            if esp.BoxLines[i] then esp.BoxLines[i]:Destroy() end
            if esp.BoxLineOutlines[i] then esp.BoxLineOutlines[i]:Destroy() end
        end
        for i = 1, 8 do
            if esp.BoxCornerLines[i] then esp.BoxCornerLines[i]:Destroy() end
            if esp.BoxCornerOutlines[i] then esp.BoxCornerOutlines[i]:Destroy() end
        end
        if esp.BoxFill then esp.BoxFill:Destroy() end
    end
    espLabels = {}
    for _, cache in pairs(skeletonCache) do
        for _, l in pairs(cache.lines) do l:Remove() end
        for _, j in pairs(cache.joints) do j:Remove() end
    end
    skeletonCache = {}
    for _, a in pairs(arrowDrawings) do if a.Remove then a:Remove() end end
    arrowDrawings = {}
    for _, cache in pairs(ChamsCache) do
        for _, h in pairs(cache) do
            if h.Remove then h:Remove() else h:Destroy() end
        end
    end
    ChamsCache = {}
    for _, set in pairs(HealthBarDrawings) do for _, sq in pairs(set) do sq:Remove() end end
    HealthBarDrawings = {}
    for _, c in pairs(game.CoreGui:GetChildren()) do
        if c.Name == "XanaxESP" or c.Name == "XanaxUI" then c:Destroy() end
    end
    shared.__XANAX_RUNNING = false
    shared.__XANAX_UNLOAD = nil
end

shared.__XANAX_RUNNING = true

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer and p.Character then addESPToPlayer(p) end
end
