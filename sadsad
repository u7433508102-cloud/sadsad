local function gaussianRandom(mean, sd)
    local u1 = math.random(); if u1 < 1e-6 then u1 = 1e-6 end
    local u2 = math.random()
    return mean + math.sqrt(-2*math.log(u1))*math.cos(2*math.pi*u2)*sd
end

