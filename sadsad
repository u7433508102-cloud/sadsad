local function CreateSquare()
    local obj = { _Size = Vector2.new(0,0), _Position = Vector2.new(0,0), _Color = Color3.new(1,1,1), _Visible = false, _Filled = false, _Thickness = 1, _Transparency = 1 }
    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1; frame.BackgroundColor3 = obj._Color; frame.Visible = obj._Visible
    frame.BorderSizePixel = 0; frame.Parent = ESPGui
    local stroke = Instance.new("UIStroke"); stroke.Thickness = obj._Thickness; stroke.Parent = frame
    return setmetatable({}, {
        __newindex = function(_, k, v)
            if k == "Size" then obj._Size = v; frame.Size = UDim2.fromOffset(v.X, v.Y)
            elseif k == "Position" then obj._Position = v; frame.Position = UDim2.fromOffset(v.X, v.Y)
            elseif k == "Color" then obj._Color = v; frame.BackgroundColor3 = v; stroke.Color = v
            elseif k == "Visible" then obj._Visible = v; frame.Visible = v
            elseif k == "Filled" then obj._Filled = v; frame.BackgroundTransparency = v and math.clamp(1 - obj._Transparency, 0, 1) or 1; stroke.Enabled = not v
            elseif k == "Thickness" then obj._Thickness = v; stroke.Thickness = v
            elseif k == "Transparency" then obj._Transparency = v; frame.BackgroundTransparency = obj._Filled and math.clamp(1 - v, 0, 1) or 1; stroke.Transparency = math.clamp(1 - v, 0, 1) end
        end,
        __index = function(_, k) if k == "Remove" or k == "Destroy" then return function() frame:Destroy() end end; return obj[k] end
    })
end

local function GetHealthBarArmor(player)
    local ch = player and player.Character
    local be = ch and ch:FindFirstChild("BodyEffects")
    local ao = be and (be:FindFirstChild("Armor") or be:FindFirstChild("Armour") or be:FindFirstChild("Defense"))
    if ao and tonumber(ao.Value) then return tonumber(ao.Value), true end
    local ls = player and player:FindFirstChild("leaderstats")
    local la = ls and (ls:FindFirstChild("Armor") or ls:FindFirstChild("Armour") or ls:FindFirstChild("Defense") or ls:FindFirstChild("Vest"))
    if la and tonumber(la.Value) then return tonumber(la.Value), true end
    return 0, false
end

local function GetStableHealthBarValues(player, humanoid)
    local cache = HealthBarValueCache[player]
    if not cache or cache.Character ~= player.Character then
        cache = { Character = player.Character, Health = tonumber(humanoid.Health) or 0, MaxHealth = tonumber(humanoid.MaxHealth) or 100, Armor = 0, ZeroSince = nil, ArmorMissingSince = nil }
        HealthBarValueCache[player] = cache
    end
    local rMax = tonumber(humanoid.MaxHealth)
    if rMax and rMax > 0 and rMax == rMax then cache.MaxHealth = rMax end
    local maxHealth = cache.MaxHealth > 0 and cache.MaxHealth or 100
    local rHealth = tonumber(humanoid.Health)
    local isDead = humanoid:GetState() == Enum.HumanoidStateType.Dead or not humanoid.Parent
    if rHealth and rHealth == rHealth and rHealth > 0 then cache.Health = math.clamp(rHealth, 0, maxHealth); cache.ZeroSince = nil
    elseif isDead then cache.Health = 0; cache.ZeroSince = 0
    else cache.ZeroSince = nil end
    local rArmor, hasArmor = GetHealthBarArmor(player)
    if hasArmor then cache.Armor = math.max(tonumber(rArmor) or 0, 0); cache.ArmorMissingSince = nil
    else
        cache.ArmorMissingSince = cache.ArmorMissingSince or 0
        if tick() - cache.ArmorMissingSince >= 0.3 then cache.Armor = 0 end
    end
    return cache.Health, maxHealth, cache.Armor, isDead
end

