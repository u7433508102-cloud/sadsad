        player = player,
        nameTag = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Weapon = Drawing.new("Text"),
        HealthText = Drawing.new("Text"),
        Flag = Drawing.new("Text"),
        HeadDot = Drawing.new("Circle"),
        HeadDotOutline = Drawing.new("Circle"),
        BoxLines = {}, BoxLineOutlines = {},
        BoxCornerLines = {}, BoxCornerOutlines = {},
    }

    esp.nameTag.Size = 14; esp.nameTag.Center = true; esp.nameTag.Outline = true
    esp.nameTag.OutlineColor = Color3.fromRGB(0,0,0); esp.nameTag.Color = Config['ESP']['Names']['Color']
    esp.nameTag.Visible = false; esp.nameTag.ZIndex = 1000
    esp.Distance.Size = 12; esp.Distance.Center = true; esp.Distance.Outline = true
    esp.Distance.OutlineColor = Color3.fromRGB(0,0,0)
    esp.Distance.Color = Color3.fromRGB(220, 220, 220); esp.Distance.Visible = false
    esp.Weapon.Size = 12; esp.Weapon.Center = true; esp.Weapon.Outline = true
    esp.Weapon.OutlineColor = Color3.fromRGB(0,0,0)
    esp.Weapon.Color = Color3.fromRGB(255, 210, 90); esp.Weapon.Visible = false
    esp.HealthText.Size = 11; esp.HealthText.Center = true; esp.HealthText.Outline = true
    esp.HealthText.OutlineColor = Color3.fromRGB(0,0,0)
    esp.HealthText.Color = Color3.fromRGB(255,255,255); esp.HealthText.Visible = false
    esp.Flag.Size = 11; esp.Flag.Center = false; esp.Flag.Outline = true
    esp.Flag.OutlineColor = Color3.fromRGB(0,0,0)
    esp.Flag.Color = Color3.fromRGB(255, 90, 90); esp.Flag.Visible = false
    esp.HeadDot.Radius = 4; esp.HeadDot.NumSides = 20; esp.HeadDot.Filled = true
    esp.HeadDot.Color = Color3.fromRGB(255,255,255); esp.HeadDot.Visible = false
    esp.HeadDotOutline.Radius = 6; esp.HeadDotOutline.NumSides = 24; esp.HeadDotOutline.Filled = false
    esp.HeadDotOutline.Thickness = 1.5; esp.HeadDotOutline.Color = Color3.fromRGB(0,0,0); esp.HeadDotOutline.Visible = false

    local boxCfg = Config['ESP']['Boxes']
    local boxColor = boxCfg['Color'] or Color3.fromRGB(255,255,255)
    local outlineColor = (boxCfg['Outlines'] and boxCfg['Outlines']['Color']) or Color3.fromRGB(0,0,0)

    for i = 1, 4 do
        local line = Instance.new("Frame")
        line.BorderSizePixel = 0; line.BackgroundColor3 = boxColor
        line.ZIndex = 2; line.Visible = false; line.Parent = ESPGui
        local ol = Instance.new("Frame")
        ol.BorderSizePixel = 0; ol.BackgroundColor3 = outlineColor
        ol.ZIndex = 1; ol.Visible = false; ol.Parent = line
        esp.BoxLines[i] = line; esp.BoxLineOutlines[i] = ol
    end
    for i = 1, 8 do
        local line = Instance.new("Frame")
        line.BorderSizePixel = 0; line.BackgroundColor3 = boxColor
        line.ZIndex = 2; line.Visible = false; line.Parent = ESPGui
        local ol = Instance.new("Frame")
        ol.BorderSizePixel = 0; ol.BackgroundColor3 = outlineColor
        ol.ZIndex = 1; ol.Visible = false; ol.Parent = line
        esp.BoxCornerLines[i] = line; esp.BoxCornerOutlines[i] = ol
    end

    local fill = Instance.new("Frame")
    fill.BorderSizePixel = 0; fill.ZIndex = 1; fill.Visible = false
    fill.Parent = ESPGui
    local fillGrad = Instance.new("UIGradient")
    fillGrad.Parent = fill
    esp.BoxFill = fill; esp.BoxFillGradient = fillGrad

    if Config['ESP']['Chams'] and Config['ESP']['Chams']['Enabled'] then
        ChamsCache[player] = {}
    end

    espLabels[player.UserId] = esp

    if Config['Skeleton ESP']['Enabled'] then
        local lines = {}
        local joints = {}
        for i = 1, 20 do
            local l = Drawing.new("Line"); l.Visible = false
            l.Thickness = Config['Skeleton ESP']['Thickness'] or 1
            l.Color = Config['Skeleton ESP']['Color'] or Color3.new(1,1,1)
            l.Transparency = 1 - (Config['Skeleton ESP']['Transparency'] or 0)
            lines[i] = l
        end
        for i = 1, 20 do
            local j = Drawing.new("Circle"); j.Visible = false
            j.Radius = 2; j.NumSides = 12; j.Filled = true
            j.Color = Config['Skeleton ESP']['Color'] or Color3.new(1,1,1)
            joints[i] = j
        end
        skeletonCache[player] = { lines = lines, joints = joints }
    end
end

local function removeESPFromPlayer(player)
    local esp = espLabels[player.UserId]
    if esp then
        esp.nameTag:Remove(); esp.Distance:Remove(); esp.Weapon:Remove()
        esp.HealthText:Remove(); esp.Flag:Remove()
        esp.HeadDot:Remove(); esp.HeadDotOutline:Remove()
        for i = 1, 4 do
            if esp.BoxLines[i] then esp.BoxLines[i]:Destroy() end
            if esp.BoxLineOutlines[i] then esp.BoxLineOutlines[i]:Destroy() end
        end
        for i = 1, 8 do
            if esp.BoxCornerLines[i] then esp.BoxCornerLines[i]:Destroy() end
            if esp.BoxCornerOutlines[i] then esp.BoxCornerOutlines[i]:Destroy() end
        end
        if esp.BoxFill then esp.BoxFill:Destroy() end
        espLabels[player.UserId] = nil
    end
    if skeletonCache[player] then
        for _, l in pairs(skeletonCache[player].lines) do l:Remove() end
        for _, j in pairs(skeletonCache[player].joints) do j:Remove() end
        skeletonCache[player] = nil
    end
    if arrowDrawings[player] then
        if arrowDrawings[player].Remove then arrowDrawings[player]:Remove() end
        arrowDrawings[player] = nil
    end
    if ChamsCache[player] then
        for _, h in pairs(ChamsCache[player]) do
            if h.Remove then h:Remove() else h:Destroy() end
        end
        ChamsCache[player] = nil
    end
end

local function updateChams(player, character)
    if not (Config['ESP']['Chams'] and Config['ESP']['Chams']['Enabled']) then
        if ChamsCache[player] then
            for _, h in pairs(ChamsCache[player]) do
                if h.Remove then h:Remove() else h:Destroy() end
            end
            ChamsCache[player] = nil
        end
        return
    end
    if not ChamsCache[player] then ChamsCache[player] = {} end
    local col = Config['ESP']['Chams']['Color'] or Color3.fromRGB(255, 60, 60)
    local trans = Config['ESP']['Chams']['Transparency'] or 0.5
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local h = ChamsCache[player][part]
            if not h then
                h = Instance.new("Highlight")
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 1
                h.OutlineTransparency = trans
                h.Adornee = part
                h.Parent = part
                ChamsCache[player][part] = h
            end
            h.OutlineColor = col; h.FillColor = col; h.OutlineTransparency = trans
        end
    end
end

local function refreshESP()
    if not Config['ESP']['Enabled'] then
        for _, esp in pairs(espLabels) do
            esp.nameTag.Visible = false; esp.Distance.Visible = false
            esp.Weapon.Visible = false; esp.HealthText.Visible = false
            esp.Flag.Visible = false; esp.HeadDot.Visible = false
            esp.HeadDotOutline.Visible = false
            for i = 1, 4 do
                if esp.BoxLines[i] then esp.BoxLines[i].Visible = false end
                if esp.BoxLineOutlines[i] then esp.BoxLineOutlines[i].Visible = false end
            end
            for i = 1, 8 do
                if esp.BoxCornerLines[i] then esp.BoxCornerLines[i].Visible = false end
                if esp.BoxCornerOutlines[i] then esp.BoxCornerOutlines[i].Visible = false end
            end
            if esp.BoxFill then esp.BoxFill.Visible = false end
        end
        return
    end

    for userId, esp in pairs(espLabels) do
        local player = esp.player
        local char = player and player.Character

        local function hideAll()
            esp.nameTag.Visible = false; esp.Distance.Visible = false
            esp.Weapon.Visible = false; esp.HealthText.Visible = false
            esp.Flag.Visible = false; esp.HeadDot.Visible = false
            esp.HeadDotOutline.Visible = false
            for i = 1, 4 do
                if esp.BoxLines[i] then esp.BoxLines[i].Visible = false end
                if esp.BoxLineOutlines[i] then esp.BoxLineOutlines[i].Visible = false end
            end
            for i = 1, 8 do
                if esp.BoxCornerLines[i] then esp.BoxCornerLines[i].Visible = false end
                if esp.BoxCornerOutlines[i] then esp.BoxCornerOutlines[i].Visible = false end
            end
            if esp.BoxFill then esp.BoxFill.Visible = false end
        end

        if not player or not player.Parent or not char
            or not char:FindFirstChild("HumanoidRootPart")
            or not char:FindFirstChild("Head") then
            hideAll()
            if skeletonCache[player] then
                for _, l in pairs(skeletonCache[player].lines) do l.Visible = false end
                for _, j in pairs(skeletonCache[player].joints) do j.Visible = false end
            end
            if arrowDrawings[player] then arrowDrawings[player].Visible = false end
            continue
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            hideAll()
            if skeletonCache[player] then
                for _, l in pairs(skeletonCache[player].lines) do l.Visible = false end
                for _, j in pairs(skeletonCache[player].joints) do j.Visible = false end
            end
            if arrowDrawings[player] then arrowDrawings[player].Visible = false end
            continue
        end

        updateChams(player, char)

        local rootPart = char.HumanoidRootPart
        local head = char.Head

        local lowestY, lowestPart = math.huge, nil
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
                if part.Position.Y < lowestY then lowestY = part.Position.Y; lowestPart = part end
            end
        end

        local legPos, onScreen
        if lowestPart then legPos, onScreen = Camera:WorldToViewportPoint(lowestPart.Position)
        else legPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 1.5, 0)) end

        local headPos = Camera:WorldToViewportPoint(head.Position)

        if not onScreen or legPos.Z <= 0 then
            hideAll()
            if skeletonCache[player] then
                for _, l in pairs(skeletonCache[player].lines) do l.Visible = false end
                for _, j in pairs(skeletonCache[player].joints) do j.Visible = false end
            end
            local arrowCfg = Config['Off-Screen Arrows']
            if arrowCfg and arrowCfg['Enabled'] then
                if not arrowDrawings[player] then
                    local o = Drawing.new("Triangle")
                    o.Filled = arrowCfg['Filled'] ~= false
                    arrowDrawings[player] = o
                end
                local arrow = arrowDrawings[player]
                local camPos = Camera.CFrame.Position
                local objSpace = Camera.CFrame:PointToObjectSpace(rootPart.Position)
                local angle = math.atan2(-objSpace.Y, objSpace.X)
                local dirV = Vector2.new(math.cos(angle), math.sin(angle))
                local distFromCam = math.min((rootPart.Position - camPos).Magnitude, 150)
                local vw, vh = Camera.ViewportSize.X, Camera.ViewportSize.Y
                local rf = arrowCfg['Dynamic Distance'] ~= false
                    and math.clamp(10 + math.max(0,distFromCam)/150*85, 10, 95)/400
                    or (tonumber(arrowCfg['Distance']) or 40)/400
                local as = arrowCfg['Dynamic Size'] ~= false
                    and 40 - math.clamp(10 + math.max(0,distFromCam)/150*20, 10, 30)
                    or (tonumber(arrowCfg['Size']) or 13)
                local ctr = dirV * (vw * rf) + Vector2.new(vw*0.5, vh*0.5)
                local col = arrowCfg['Color'] or Color3.new(1,1,1)
                local alpha = 1
                if arrowCfg['Blink'] then
                    alpha = 1 - (math.sin(os.clock()*(4+(arrowCfg['Blink Speed'] or 1)))+1)*0.5
                end
                local perp = Vector2.new(-dirV.Y, dirV.X)
                arrow.PointA = ctr + dirV * (as * 0.7)
                arrow.PointB = ctr - dirV * (as * 0.3) + perp * (as * 0.55)
                arrow.PointC = ctr - dirV * (as * 0.3) - perp * (as * 0.55)
                arrow.Color = col; arrow.Transparency = alpha; arrow.Visible = true
            end
            continue
        end

        if arrowDrawings[player] then arrowDrawings[player].Visible = false end

        local boxHeight = (headPos.Y - legPos.Y)
        local boxWidth = boxHeight / 2
        local boxX = legPos.X - boxWidth
        local boxY = legPos.Y - boxHeight
        local boxW = boxWidth * 2
        local boxH = boxHeight

        -- FRAME-BASED BOX
        local boxCfg = Config['ESP']['Boxes']
        local boxesEnabled = boxCfg['Enabled']
        local boxType = boxCfg['BoxType'] or 'Normal'
        local useCorner = (boxType == 'Corner')
        local thick = boxCfg['Thickness'] or 1
        local col = boxCfg['Color'] or Color3.fromRGB(255,255,255)

        local outlineStyle = (boxCfg['Outlines'] and boxCfg['Outlines']['Style']) or 'Full'
        local hasOutline = (outlineStyle ~= 'None')
        local outlineColor = (boxCfg['Outlines'] and boxCfg['Outlines']['Color']) or Color3.fromRGB(0,0,0)
        local outlineThick = (boxCfg['Outlines'] and boxCfg['Outlines']['Thickness']) or 1

        local fx = math.floor(boxX); local fy = math.floor(boxY)
        local fw = math.floor(boxW); local fh = math.floor(boxH)

        if boxesEnabled then
            if not useCorner then
                esp.BoxLines[1].Position = UDim2.new(0, fx, 0, fy)
                esp.BoxLines[1].Size = UDim2.new(0, fw, 0, thick)
                esp.BoxLines[2].Position = UDim2.new(0, fx, 0, fy + fh)
                esp.BoxLines[2].Size = UDim2.new(0, fw + thick, 0, thick)
                esp.BoxLines[3].Position = UDim2.new(0, fx, 0, fy)
                esp.BoxLines[3].Size = UDim2.new(0, thick, 0, fh)
                esp.BoxLines[4].Position = UDim2.new(0, fx + fw, 0, fy)
                esp.BoxLines[4].Size = UDim2.new(0, thick, 0, fh + thick)
                for i = 1, 4 do
                    esp.BoxLines[i].Visible = true
                    esp.BoxLines[i].BackgroundColor3 = col
                    local ol = esp.BoxLineOutlines[i]
                    ol.Visible = hasOutline
                    ol.BackgroundColor3 = outlineColor
                    ol.Position = UDim2.new(0, -outlineThick, 0, -outlineThick)
                    ol.Size = UDim2.new(1, outlineThick * 2, 1, outlineThick * 2)
                end
                for i = 1, 8 do
                    esp.BoxCornerLines[i].Visible = false
                    esp.BoxCornerOutlines[i].Visible = false
                end
            else
                local cw = math.max(math.floor(fw * 0.25), thick * 4)
                local ch = math.max(math.floor(fh * 0.25), thick * 4)
                local cornerData = {
                    { fx, fy, cw, thick },
                    { fx, fy, thick, ch },
                    { fx + fw - cw + thick, fy, cw, thick },
                    { fx + fw, fy, thick, ch },
                    { fx, fy + fh, cw, thick },
                    { fx, fy + fh - ch + thick, thick, ch },
                    { fx + fw - cw + thick, fy + fh, cw, thick },
                    { fx + fw, fy + fh - ch + thick, thick, ch },
                }
                for i = 1, 8 do
                    local d = cornerData[i]
                    esp.BoxCornerLines[i].Position = UDim2.new(0, d[1], 0, d[2])
                    esp.BoxCornerLines[i].Size = UDim2.new(0, d[3], 0, d[4])
                    esp.BoxCornerLines[i].Visible = true
                    esp.BoxCornerLines[i].BackgroundColor3 = col
                    local ol = esp.BoxCornerOutlines[i]
                    ol.Visible = hasOutline
                    ol.BackgroundColor3 = outlineColor
                    ol.Position = UDim2.new(0, -outlineThick, 0, -outlineThick)
                    ol.Size = UDim2.new(1, outlineThick * 2, 1, outlineThick * 2)
                end
                for i = 1, 4 do
                    esp.BoxLines[i].Visible = false
                    esp.BoxLineOutlines[i].Visible = false
                end
            end

            local fillCfg = boxCfg['Fill']
            if fillCfg and fillCfg['Enabled'] then
                esp.BoxFill.Visible = true
                esp.BoxFill.Position = UDim2.new(0, fx, 0, fy)
                esp.BoxFill.Size = UDim2.new(0, fw, 0, fh)
                esp.BoxFill.BackgroundTransparency = fillCfg['Transparency'] or 0.85
                local gradCfg = fillCfg['Gradient']
                if gradCfg and gradCfg['Enabled'] then
                    esp.BoxFillGradient.Enabled = true
                    esp.BoxFillGradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0,   gradCfg['Color1']),
                        ColorSequenceKeypoint.new(0.5, gradCfg['Color2']),
                        ColorSequenceKeypoint.new(1,   gradCfg['Color3']),
                    })
                    local rot = gradCfg['Rotation'] or 0
                    if gradCfg['Animated'] then
                        local speed = gradCfg['Speed'] or 60
                        local dir = (gradCfg['Direction'] == 'Left') and -1 or 1
                        rot = (rot + (os.clock() * speed * dir)) % 360
                    end
                    esp.BoxFillGradient.Rotation = rot
                    esp.BoxFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                else
                    esp.BoxFillGradient.Enabled = false
                    esp.BoxFill.BackgroundColor3 = fillCfg['Color'] or col
                end
            else
                esp.BoxFill.Visible = false
            end
        else
            for i = 1, 4 do
                esp.BoxLines[i].Visible = false
                esp.BoxLineOutlines[i].Visible = false
            end
            for i = 1, 8 do
                esp.BoxCornerLines[i].Visible = false
                esp.BoxCornerOutlines[i].Visible = false
            end
            esp.BoxFill.Visible = false
        end

        if Config['ESP']['HeadDot'] ~= false then
            esp.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
            esp.HeadDot.Radius = math.max(2, boxHeight * 0.06)
            esp.HeadDot.Color = boxCfg['Color'] or Color3.fromRGB(255,255,255)
            esp.HeadDot.Visible = true
            esp.HeadDotOutline.Position = Vector2.new(headPos.X, headPos.Y)
            esp.HeadDotOutline.Radius = esp.HeadDot.Radius + 2
            esp.HeadDotOutline.Visible = true
        else
            esp.HeadDot.Visible = false
            esp.HeadDotOutline.Visible = false
        end

        local hbCfg = Config['Health Bar']
        if hbCfg and hbCfg['Enabled'] then
            local hV, mH = GetStableHealthBarValues(player, hum)
            if hbCfg['ShowNumber'] ~= false then
                esp.HealthText.Text = tostring(math.ceil(hV))
                esp.HealthText.Position = Vector2.new(boxX - 10, boxY + boxH * 0.5)
                esp.HealthText.Color = hV / mH > 0.5 and Color3.fromRGB(90, 255, 90)
                    or hV / mH > 0.25 and Color3.fromRGB(255, 200, 80)
                    or Color3.fromRGB(255, 80, 80)
                esp.HealthText.Visible = true
            else
                esp.HealthText.Visible = false
            end
        else
            esp.HealthText.Visible = false
        end

        if Config['ESP']['Names']['Enabled'] then
            esp.nameTag.Position = Vector2.new(legPos.X, boxY - 15)
            esp.nameTag.Text = player.DisplayName or player.Name
            esp.nameTag.Color = (currentTarget and currentTarget.Parent == player.Character)
                and Config['ESP']['Names']['TargetColor'] or Config['ESP']['Names']['Color']
            esp.nameTag.Size = Config['ESP']['Names']['Text Size'] or 13
            esp.nameTag.Visible = true
        else
            esp.nameTag.Visible = false
        end

        if Config['ESP']['Weapon'] and Config['ESP']['Weapon']['Enabled'] then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                esp.Weapon.Text = "[" .. tool.Name .. "]"
                esp.Weapon.Position = Vector2.new(legPos.X, legPos.Y + 18)
                esp.Weapon.Color = Config['ESP']['Weapon']['Color'] or Color3.fromRGB(255, 210, 90)
                esp.Weapon.Visible = true
            else
                esp.Weapon.Visible = false
            end
        else
            esp.Weapon.Visible = false
        end

        if Config['ESP']['Distance']['Enabled'] then
            local dist = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
            esp.Distance.Text = dist .. "m"
            esp.Distance.Position = Vector2.new(legPos.X, legPos.Y + 5)
            esp.Distance.Color = Config['ESP']['Distance']['Color'] or Color3.fromRGB(220,220,220)
            esp.Distance.Visible = true
        else
            esp.Distance.Visible = false
        end

        if Config['ESP']['Flags'] and Config['ESP']['Flags']['Enabled'] then
            local flags = {}
            local be = char:FindFirstChild("BodyEffects")
            if be then
                local ko = be:FindFirstChild("K.O")
                if ko and ko.Value then table.insert(flags, "KO") end
            end
            if hum.FloorMaterial == Enum.Material.Air then table.insert(flags, "AIR") end
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                local reloading = tool:FindFirstChild("Reloading") or tool:FindFirstChild("IsReloading")
                if reloading and reloading.Value then table.insert(flags, "RLD") end
            end
            if #flags > 0 then
                esp.Flag.Text = table.concat(flags, " ")
                esp.Flag.Position = Vector2.new(boxX + boxW + 5, boxY)
                esp.Flag.Visible = true
            else
                esp.Flag.Visible = false
            end
        else
            esp.Flag.Visible = false
        end

        local skelCfg = Config['Skeleton ESP']
        if skelCfg and skelCfg['Enabled'] then
            if not skeletonCache[player] then
                local lines, joints = {}, {}
                for i = 1, 20 do
                    local l = Drawing.new("Line"); l.Visible = false
                    l.Thickness = skelCfg['Thickness'] or 1
                    l.Color = skelCfg['Color'] or Color3.new(1,1,1)
                    l.Transparency = 1 - (skelCfg['Transparency'] or 0)
                    lines[i] = l
                end
                for i = 1, 20 do
                    local j = Drawing.new("Circle"); j.Visible = false
                    j.Radius = 2; j.NumSides = 12; j.Filled = true
                    j.Color = skelCfg['Color'] or Color3.new(1,1,1)
                    joints[i] = j
                end
                skeletonCache[player] = { lines = lines, joints = joints }
            end
            local bones = char:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
            local cache = skeletonCache[player]
            local col = skelCfg['Color'] or Color3.new(1,1,1)
            local alpha = 1 - (skelCfg['Transparency'] or 0)
            for i, bone in ipairs(bones) do
                if i > #cache.lines then break end
                local p1 = char:FindFirstChild(bone[1]); local p2 = char:FindFirstChild(bone[2])
                local line = cache.lines[i]
                if p1 and p2 then
                    local s1, on1 = Camera:WorldToViewportPoint(p1.Position)
                    local s2, on2 = Camera:WorldToViewportPoint(p2.Position)
                    if on1 and on2 and s1.Z > 0 and s2.Z > 0 then
                        line.From = Vector2.new(s1.X, s1.Y); line.To = Vector2.new(s2.X, s2.Y)
                        line.Color = col; line.Transparency = alpha; line.Visible = true
                    else line.Visible = false end
                else line.Visible = false end
            end
            for i = #bones + 1, #cache.lines do cache.lines[i].Visible = false end

            local jointIdx = 0
            local seen = {}
            for _, bone in ipairs(bones) do
                for _, name in ipairs(bone) do
                    if not seen[name] then
                        seen[name] = true
                        local p = char:FindFirstChild(name)
                        jointIdx = jointIdx + 1
                        if jointIdx > #cache.joints then break end
                        local dot = cache.joints[jointIdx]
                        if p then
                            local s, on = Camera:WorldToViewportPoint(p.Position)
                            if on and s.Z > 0 then
                                dot.Position = Vector2.new(s.X, s.Y)
                                dot.Radius = math.max(1.5, skelCfg['JointSize'] or 2)
                                dot.Color = col; dot.Transparency = alpha; dot.Filled = true; dot.Visible = true
                            else dot.Visible = false end
                        else dot.Visible = false end
                    end
                end
            end
            for i = jointIdx + 1, #cache.joints do cache.joints[i].Visible = false end
        else
            if skeletonCache[player] then
                for _, l in pairs(skeletonCache[player].lines) do l.Visible = false end
                for _, j in pairs(skeletonCache[player].joints) do j.Visible = false end
            end
        end
    end

    -- Health bar (target only)
    local HBCfg = Config['Health Bar']
    if HBCfg and HBCfg['Enabled'] then
        local ShowArmor = HBCfg['Show Armor']
        local HealthColor = HBCfg['Health Color'] or Color3.fromRGB(85, 255, 255)
        local ArmorColor = HBCfg['Armor Color'] or Color3.fromRGB(120, 185, 255)
        local TargetPlayer = currentTarget and Players:GetPlayerFromCharacter(currentTarget.Parent)
        for player, set in pairs(HealthBarDrawings) do
            if player ~= TargetPlayer then HideHealthBarSet(set) end
        end
        if TargetPlayer then
            local ch = TargetPlayer.Character
            local rp = ch and ch:FindFirstChild('HumanoidRootPart')
            local hum = ch and ch:FindFirstChildOfClass('Humanoid')
            if rp and hum then
                local lowP, lowY = nil, math.huge
                for _, part in ipairs(ch:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
                        if part.Position.Y < lowY then lowY = part.Position.Y; lowP = part end
                    end
                end
                local bp = lowP and lowP.Position or (rp.Position - Vector3.new(0, 1.5, 0))
                local bs, bo = Camera:WorldToViewportPoint(bp)
                if bo and bs.Y >= 0 and bs.Y <= Camera.ViewportSize.Y then
                    local cx = bs.X; local fy = bs.Y
                    local barLen = 66; local tH = 2; local b = 1; local g = 1
                    local tW = barLen + b * 2
                    local tX = MathFloor(cx - tW / 2 + 0.5)
                    local tY = MathFloor(fy + 1 + 0.5)
                    local hBY = tY; local hFY = hBY + b
                    local aBY = hBY + tH + b * 2 + g; local aFY = aBY + b
                    if not HealthBarDrawings[TargetPlayer] then
                        local set = {}
                        for _, key in ipairs({'HealthBack','HealthFill','ArmorBack','ArmorFill'}) do
                            local sq = CreateSquare(); sq.Filled = true; sq.Visible = false; set[key] = sq
                        end
                        HealthBarDrawings[TargetPlayer] = set
                    end
                    local set = HealthBarDrawings[TargetPlayer]
                    local hV, mH, aV, isDead = GetStableHealthBarValues(TargetPlayer, hum)
                    local hF = math.clamp(hV / mH, 0, 1)
                    local aF = math.clamp(aV / 100, 0, 1)
                    local drawA = ShowArmor and aV > 0
                    set.HealthBack.Color = Color3.fromRGB(8, 8, 12)
                    set.HealthFill.Color = HealthColor
                    set.ArmorBack.Color = Color3.fromRGB(8, 8, 12)
                    set.ArmorFill.Color = ArmorColor
                    set.HealthBack.Size = Vector2.new(tW, tH + b * 2)
                    set.HealthBack.Position = Vector2.new(tX, hBY)
                    set.HealthFill.Size = Vector2.new(MathFloor(barLen * hF + 0.5), tH)
                    set.HealthFill.Position = Vector2.new(tX + b, hFY)
                    set.ArmorBack.Size = Vector2.new(tW, tH + b * 2)
                    set.ArmorBack.Position = Vector2.new(tX, aBY)
                    set.ArmorFill.Size = Vector2.new(MathFloor(barLen * aF + 0.5), tH)
                    set.ArmorFill.Position = Vector2.new(tX + b, aFY)
                    local sh = hF > 0 and not isDead
                    set.HealthBack.Visible = sh; set.HealthFill.Visible = sh
                    set.ArmorBack.Visible = drawA and not isDead
                    set.ArmorFill.Visible = drawA and aF > 0 and not isDead
                else
