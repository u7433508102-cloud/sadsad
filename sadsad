-- HOOKS
-- ══════════════════════════════════════════════════════════════
if not getgenv().XanaxHooks then getgenv().XanaxHooks = {} end
local HK = getgenv().XanaxHooks

if HK.index then
    pcall(function()
        setreadonly(getrawmetatable(game), false)
        getrawmetatable(game).__index = HK.index
        setreadonly(getrawmetatable(game), true)
    end)
    HK.index = nil
end
if HK.random then
    pcall(function() hookfunction(math.random, HK.random) end)
    HK.random = nil
end
HK.depth_index = 0
HK.depth_random = 0

local function findClosestPlayer()
    local best, bestD = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local rp = p.Character.HumanoidRootPart
            local sp, on = Camera:WorldToViewportPoint(rp.Position)
            if on then
                local d = (Vector2.new(sp.X,sp.Y)-Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                if d < bestD then bestD=d; best=p end
            end
        end
    end
    return best
end

do
    local originalIndex = getrawmetatable(game).__index
    HK.index = originalIndex
    setreadonly(getrawmetatable(game), false)
    getrawmetatable(game).__index = function(self, key)
        HK.depth_index = HK.depth_index + 1
        if HK.depth_index > 10 then
            HK.depth_index = HK.depth_index - 1
            return originalIndex(self, key)
        end
        local ok2, result = pcall(function()
            if checkcaller() then return nil end
            if not (Config and Config.SilentAim and Config.SilentAim.Enabled) then return nil end
            if not self:IsA("Mouse") then return nil end
            if key ~= "Hit" and key ~= "Target" then return nil end
            if bulletTPActive then
                local tgt = spectateTarget
                if not tgt or not tgt.Character or not tgt.Character:FindFirstChild("HumanoidRootPart") then tgt = findClosestPlayer() end
                if tgt and tgt.Character then
                    local pt = tgt.Character:FindFirstChild("Head") or tgt.Character:FindFirstChild("HumanoidRootPart")
                    if pt then
                        local v = pt.AssemblyLinearVelocity or Vector3.new()
                        local pp = pt.Position + v*0.1
                        if key == "Hit" then return CFrame.new(pp) else return pt end
                    end
                end
            end
            if not currentTarget then return nil end
            local ch = currentTarget.Parent
            if not ch then return nil end
            local pl = Players:GetPlayerFromCharacter(ch)
            if not pl or isPlayerKnockedOrKO(pl) or not canSeeTarget(currentTarget) then return nil end
            if not isTargetInFOV(currentTarget) then return nil end
            if key == "Hit" then
                local aim = currentTargetPoint or getPredictedPosition(currentTarget, Config.SilentAim)
                if Config.AdvancedAim.GaussianRandom then
                    local s = Config.AdvancedAim.GaussianSpread or 0.6
                    aim = aim + Vector3.new(gaussianRandom(0,s),gaussianRandom(0,s),gaussianRandom(0,s))
                end
                if Config.SilentAim.Method == "Viewport" then
                    local sp, on = Camera:WorldToViewportPoint(aim)
                    if on then
                        local ray = Camera:ViewportPointToRay(sp.X, sp.Y)
                        local d = (aim - Camera.CFrame.Position).Magnitude
                        return CFrame.new(ray.Origin + ray.Direction*d)
                    end
                end
                return CFrame.new(aim)
            else
                return currentTarget
            end
        end)
        HK.depth_index = HK.depth_index - 1
        if ok2 and result ~= nil then return result end
        return originalIndex(self, key)
    end
end

do
    local originalRandom = math.random
    HK.random = originalRandom
    local hookFn = function(...)
        HK.depth_random = HK.depth_random + 1
        if HK.depth_random > 10 then
            HK.depth_random = HK.depth_random - 1
            return originalRandom(...)
        end
        local args = {...}
        local result = originalRandom(...)
        pcall(function()
            if checkcaller() then return end
            if not (Config and Config.Spread and Config.Spread.Enabled) then return end
            local isRecoil = (#args == 0) or (args[1] == -0.05 and args[2] == 0.05) or (args[1] == -0.1) or (args[1] == -0.05)
            if not isRecoil then return end
            local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if not tool then return end
            if Config.Spread.SpecificWeapons.Enabled then
                local found = false
                for _, w in pairs(Config.Spread.SpecificWeapons.Weapons) do
                    if tool.Name == w then found=true; break end
                end
                if not found then return end
            end
            result = result * (Config.Spread.Amount/100)
        end)
        HK.depth_random = HK.depth_random - 1
        return result
    end
    hookfunction(math.random, hookFn)
end

-- ══════════════════════════════════════════════════════════════
-- DESYNC — CFrame offset only, no animation freeze
-- ══════════════════════════════════════════════════════════════
local function randomOffsetSafe()
    local dr = Config.Desync.Range or 1e9
    local mnY = Config.Desync.MinY or 100
    local mxY = Config.Desync.MaxY or 50000
    return Vector3.new((math.random()*2-1)*dr, mnY+math.random()*(mxY-mnY), (math.random()*2-1)*dr)
end

function stopDesync()
    if not desyncActive then return end
    desyncActive = false
    desyncRoot = nil
    desyncHumanoid = nil
    desyncOriginalCFrame = nil
    if desyncCircle then desyncCircle.Visible = false end
    if desyncLine then desyncLine.Visible = false end
end

local function startDesync()
    if desyncActive then return end
    local ch = LocalPlayer.Character
    local root = getRootPart(LocalPlayer)
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    desyncRoot = root
    desyncHumanoid = hum
    desyncOriginalCFrame = root.CFrame
    if not desyncCircle then
        desyncCircle = Drawing.new("Circle")
        desyncCircle.Thickness = 2
        desyncCircle.Color = Color3.fromRGB(255,0,0)
        desyncCircle.Radius = 8
        desyncCircle.Filled = true
        desyncCircle.Visible = false
    end
    if not desyncLine then
        desyncLine = Drawing.new("Line")
        desyncLine.Thickness = 2
        desyncLine.Color = Color3.fromRGB(255,0,0)
        desyncLine.Visible = false
    end
    desyncActive = true
    table.insert(connections, RunService.Heartbeat:Connect(function()
        if not desyncActive or not desyncRoot or not desyncRoot.Parent then
            stopDesync(); return
        end
        local off = randomOffsetSafe()
        desyncRoot.CFrame = desyncOriginalCFrame * CFrame.new(off)
    end))
    table.insert(connections, RunService.RenderStepped:Connect(function()
        if not desyncActive or not desyncOriginalCFrame then
            if desyncCircle then desyncCircle.Visible = false end
            if desyncLine then desyncLine.Visible = false end
            return
        end
        local op = desyncOriginalCFrame.Position
        local sp, on = Camera:WorldToViewportPoint(op)
        if on then
            desyncCircle.Position = Vector2.new(sp.X, sp.Y)
            desyncCircle.Visible = true
        else
            desyncCircle.Visible = false
        end
        if desyncRoot and desyncRoot.Parent then
            local cs, co = Camera:WorldToViewportPoint(desyncRoot.Position)
            local os2, oo = Camera:WorldToViewportPoint(op)
            if co and oo then
                desyncLine.From = Vector2.new(cs.X, cs.Y)
                desyncLine.To = Vector2.new(os2.X, os2.Y)
                desyncLine.Visible = true
            else
                desyncLine.Visible = false
            end
        else
            desyncLine.Visible = false
        end
    end))
end

local function toggleDesync()
    if desyncActive then
        stopDesync()
    else
        if not Config.Desync.Enabled then return end
        startDesync()
    end
end

