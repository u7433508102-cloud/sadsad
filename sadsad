-- ══════════════════════════════════════════════════════════════
-- INVENTORY SORTER (hotbar + backpack)
-- ══════════════════════════════════════════════════════════════
do
    local IS = Config.InventorySorter
    if IS and IS.Enabled then
        local function getBackpack()
            return LocalPlayer:FindFirstChild("Backpack")
        end
        local function getHotbarTools()
            local char = LocalPlayer.Character
            local tools = {}
            if char then
                for _, c in ipairs(char:GetChildren()) do
                    if c:IsA("Tool") then table.insert(tools, c) end
                end
            end
            return tools
        end
        local function getAllTools()
            local tools = {}
            for _, t in ipairs(getHotbarTools()) do table.insert(tools, t) end
            local bp = getBackpack()
            if bp then
                for _, c in ipairs(bp:GetChildren()) do
                    if c:IsA("Tool") then table.insert(tools, c) end
                end
            end
            return tools
        end
        local function priorityIndex(name)
            for i, pname in ipairs(IS.Prioritize) do
                if name == pname or name:find(pname, 1, true) then return i end
            end
            return nil
        end
        local function sortTools()
            local tools = getAllTools()
            if #tools == 0 then return end
            local prioritized, rest = {}, {}
            for _, t in ipairs(tools) do
                local idx = priorityIndex(t.Name)
                if idx then
                    table.insert(prioritized, { idx = idx, tool = t })
                else
                    table.insert(rest, t)
                end
            end
            table.sort(prioritized, function(a, b) return a.idx < b.idx end)
            table.sort(rest, function(a, b) return a.Name < b.Name end)
            local backpack = getBackpack()
            if not backpack then return end
            for _, t in ipairs(tools) do
                if t.Parent ~= backpack then
                    pcall(function() t.Parent = backpack end)
                end
            end
            RunService.Heartbeat:Wait()
            local maxHotbar = 9
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            for i, entry in ipairs(prioritized) do
                if i > maxHotbar then break end
                pcall(function() hum:EquipTool(entry.tool) end)
                RunService.Heartbeat:Wait()
            end
        end
        local lastAutoSort = 0
        if IS.AutoSort then
            table.insert(connections, RunService.Heartbeat:Connect(function()
                if tick() - lastAutoSort < (IS.AutoSortDelay or 1.5) then return end
                lastAutoSort = tick()
                pcall(sortTools)
            end))
        end
        table.insert(connections, UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode[IS.Key] then
                pcall(sortTools)
            end
        end))
    end
end

