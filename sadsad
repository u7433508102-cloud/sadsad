        local function applyModelOnHolder(holder, skinModel)
            if not holder or not skinModel then return end
            local handle = holder:FindFirstChild("Handle")
            if not isBasePart(handle) then return end
            local old = holder:FindFirstChild("SkinModel")
            if old then old:Destroy() end
            local clone = skinModel:Clone()
            clone.Name = "SkinModel"
            local primary = ensurePrimaryPart(clone)
            if not isBasePart(primary) then return end
            prepParts(clone, holder.Name:find("Knife") and true or false)
            clone.Parent = holder
            clone:PivotTo(handle.CFrame)
            for _, part in ipairs(clone:GetDescendants()) do
                if part:IsA("BasePart") then weldParts(handle, part) end
            end
            handle.Transparency = 1
        end
        local function applyToolSkin(tool)
            if not tool or not tool:IsA("Tool") then return end
            local wname = tool.Name:match("^%[(.+)%]$")
            if not wname then return end
            local sname = SkinCfg['Skins'][wname]
            if not sname or sname == "" then return end
            local sm = getWrapSkin(wname, sname, 5)
            if sm then applyModelOnHolder(tool, sm) end
        end
        local function applyKnifeSkin(tool)
            if not tool or not tool:IsA("Tool") then return end
            if tool.Name ~= "[Knife]" then return end
            local kn = SkinCfg['Special Skins'] and SkinCfg['Special Skins']['Knife']
            if not kn or kn == "" then return end
            local knives = ReplicatedStorage:FindFirstChild("Knives")
            if not knives then return end
            local sm = knives:FindFirstChild(kn)
            if sm then applyModelOnHolder(tool, sm) end
        end
        local function applyHandleSkin(character, handleFolder)
            local wname = HANDLE_MAP[handleFolder]
            if not wname then return end
            local sname = SkinCfg['Skins'][wname]
            if not sname or sname == "" then return end
            local folder = character:FindFirstChild(handleFolder)
            if not folder then return end
            local sm = getWrapSkin(wname, sname, 5)
            if sm then applyModelOnHolder(folder, sm) end
        end
        local function applyAll(character)
            for _, tool in ipairs(character:GetChildren()) do
                if tool:IsA("Tool") then applyToolSkin(tool); applyKnifeSkin(tool) end
            end
            for handleName, _ in pairs(HANDLE_MAP) do applyHandleSkin(character, handleName) end
        end
        local function connect(character)
            table.insert(connections, character.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then
                    task.defer(function() applyToolSkin(child); applyKnifeSkin(child) end)
                elseif HANDLE_MAP[child.Name] then
                    task.defer(function() applyHandleSkin(character, child.Name) end)
                end
            end))
            applyAll(character)
        end
        table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(char)
            task.wait(0.5); connect(char)
        end))
        if LocalPlayer.Character then
            task.defer(function() task.wait(0.5); connect(LocalPlayer.Character) end)
        end
    end
end

-- ══════════════════════════════════════════════════════════════
-- HOOD FEATURES (Auto Stomp / Auto Reload / Anti Stomp / Fake AFK)
-- ══════════════════════════════════════════════════════════════
do
    local HoodCfg = Config['Hood Features']
    if HoodCfg then
        local MainEvent = ReplicatedStorage:WaitForChild("MainEvent", 10)

        -- Auto Stomp
        local stompState = { active = false, running = false, returnCFrame = nil, target = nil }
        local function findKnockedPlayer()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local c = p.Character
                    local be = c and c:FindFirstChild("BodyEffects")
                    local ko = be and be:FindFirstChild("K.O")
                    local dead = be and be:FindFirstChild("Dead")
                    if ko and ko.Value and dead and not dead.Value then return p end
                end
            end
        end
        local function stopAutoStomp()
            stompState.active = false; stompState.running = false
            if stompState.returnCFrame then
                local c = LocalPlayer.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.CFrame = stompState.returnCFrame end
                stompState.returnCFrame = nil
            end
            stompState.target = nil
        end
        local function startAutoStompLoop()
            if stompState.running then return end
            stompState.running = true
            task.spawn(function()
                local yOff = HoodCfg['Auto Stomp']['Y Offset'] or 3.5
                local stomps = HoodCfg['Auto Stomp']['Stomp Count'] or 5
                while stompState.active do
                    local c = LocalPlayer.Character
                    local hrp = c and c:FindFirstChild("HumanoidRootPart")
                    local hum = c and c:FindFirstChildWhichIsA("Humanoid")
                    if not c or not hrp or not hum then task.wait(); continue end
                    if not stompState.target then stompState.target = findKnockedPlayer() end
                    local t = stompState.target
                    local tc = t and t.Character
                    local be = tc and tc:FindFirstChild("BodyEffects")
                    local ko = be and be:FindFirstChild("K.O")
                    local dead = be and be:FindFirstChild("Dead")
                    if not t or not ko or not ko.Value or (dead and dead.Value) then
                        if stompState.returnCFrame then hrp.CFrame = stompState.returnCFrame end
                        stompState.returnCFrame = nil; stompState.target = nil
                        task.wait(); continue
                    end
                    local ut = tc:FindFirstChild("UpperTorso")
                    if ut and MainEvent then
                        if not stompState.returnCFrame then stompState.returnCFrame = hrp.CFrame end
                        hum.Sit = false; hum.PlatformStand = false
                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                        pcall(function() hrp.Velocity = Vector3.zero end)
                        hrp.CFrame = CFrame.new(ut.Position + Vector3.new(0, yOff, 0))
                        RunService.RenderStepped:Wait()
                        for _ = 1, stomps do pcall(function() MainEvent:FireServer("Stomp") end) end
                        hrp.CFrame = stompState.returnCFrame
                    end
                    task.wait()
                end
                stompState.target = nil; stompState.returnCFrame = nil; stompState.running = false
            end)
        end
        if HoodCfg['Auto Stomp'] and HoodCfg['Auto Stomp']['Enabled'] then
            stompState.active = true
            startAutoStompLoop()
        end
        getgenv().XanaxSetAutoStomp = function(v)
            stompState.active = v
            if v then startAutoStompLoop() else stopAutoStomp() end
        end

        -- Auto Reload
        if HoodCfg['Auto Reload'] and HoodCfg['Auto Reload']['Enabled'] then
            local ReloadCfg = HoodCfg['Auto Reload']
            local lastReload = {}
            local cooldown = ReloadCfg['Cooldown'] or 1.0
            local tools = ReloadCfg['Tools'] or {}
            table.insert(connections, RunService.RenderStepped:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                for _, name in ipairs(tools) do
                    local t = char:FindFirstChild(name)
                    if t and (not lastReload[name] or tick() - lastReload[name] >= cooldown) then
                        local s = t:FindFirstChild("Script")
                        local a = s and s:FindFirstChild("Ammo")
                        if a and a:IsA("IntValue") and a.Value == 0 then
                            pcall(function()
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, nil)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, nil)
                            end)
                            lastReload[name] = tick()
                        end
                    end
                end
            end))
        end

        -- Anti Stomp
        if HoodCfg['Anti Stomp'] and HoodCfg['Anti Stomp']['Enabled'] then
            local antiKey = HoodCfg['Anti Stomp']['Key'] or 'P'
            table.insert(connections, UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if input.KeyCode == Enum.KeyCode[antiKey] then
                    local char = LocalPlayer.Character
                    if not char then return end
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then pcall(function() part:Destroy() end) end
                    end
                end
            end))
        end

        -- Fake AFK
        if HoodCfg['Fake AFK'] and HoodCfg['Fake AFK']['Enabled'] and MainEvent then
            local interval = HoodCfg['Fake AFK']['Interval'] or 0.5
            task.spawn(function()
                while shared.__XANAX_RUNNING and HoodCfg['Fake AFK']['Enabled'] do
                    pcall(function() MainEvent:FireServer("RequestAFKDisplay", true) end)
                    task.wait(interval)
                end
            end)
        end
    end
end

