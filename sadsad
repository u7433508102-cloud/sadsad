-- DEVICE SPOOFER
-- ══════════════════════════════════════════════════════════════
do
    local DevCfg = Config['Device Spoofer']
    if DevCfg and DevCfg['Enabled'] then
        local MainEvent = ReplicatedStorage:WaitForChild("MainEvent", 10)
        if MainEvent then
            local device = DevCfg['Device'] or 'IS_DESKTOP'
            local interval = DevCfg['Interval'] or 1.0
            local valid = { IS_CONSOLE = true, IS_DESKTOP = true, IS_MOBILE = true }
            if not valid[device] then device = 'IS_DESKTOP' end
            task.spawn(function()
                while shared.__XANAX_RUNNING do
                    pcall(function() MainEvent:FireServer(device) end)
                    task.wait(interval)
                end
            end)
        end
    end
end

