RunService.RenderStepped:Connect(function()
    if not Config['Infinite Range']['Enabled'] or not infRangeActive then return end
    local character = LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    local rangeProps = {"Range", "MaxRange", "FireRange", "Distance", "MaxDistance"}
    for _, propName in pairs(rangeProps) do
        local rangeValue = tool:FindFirstChild(propName)
        if rangeValue and rangeValue:IsA("NumberValue") then
            rangeValue.Value = Config['Infinite Range']['Max Range']
        end
        local config = tool:FindFirstChild("Configuration") or tool:FindFirstChild("GunConfig")
        if config then
            local r = config:FindFirstChild(propName)
            if r and r:IsA("NumberValue") then
                r.Value = Config['Infinite Range']['Max Range']
            end
        end
    end
end)

-- ========== UI ==========
if Config['UI'] and Config['UI']['Enabled'] then
    local UIcfg = Config['UI']

    -- Helper to get font enum
    local fontEnum = Enum.Font[UIcfg['Font']] or Enum.Font.GothamBold

    local gui = Instance.new("ScreenGui")
    gui.Parent = game.CoreGui
    gui.ResetOnSpawn = false

    local text = Instance.new("TextLabel")
    text.Parent = gui
    text.AnchorPoint = Vector2.new(0.5, 1)
    text.Position = UDim2.new(0.5, UIcfg['Position']['X'] or 0, 1, UIcfg['Position']['Y'] or -72)
    text.Size = UDim2.new(0, 500, 0, 120)
    text.BackgroundTransparency = UIcfg['BackgroundTransparency'] or 1
    text.TextXAlignment = Enum.TextXAlignment.Center
    text.TextYAlignment = Enum.TextYAlignment.Center
    text.Font = fontEnum
    text.TextSize = UIcfg['TextSize'] or 16
    text.RichText = true
    text.TextStrokeTransparency = UIcfg['TextStrokeTransparency'] or 0
    text.TextStrokeColor3 = UIcfg['TextStrokeColor'] or Color3.fromRGB(0, 0, 0)

    local titleSize = UIcfg['TitleSize'] or 22
    local titleColor = UIcfg['TitleColor'] or Color3.fromRGB(120, 81, 169)
    local subtitleColor = UIcfg['SubtitleColor'] or Color3.fromRGB(255, 255, 255)
    local statusColor = UIcfg['StatusColor'] or Color3.fromRGB(255, 255, 255)
    local targetColor = UIcfg['TargetColor'] or Color3.fromRGB(120, 81, 169)
    local sepColor = UIcfg['SeparatorColor'] or Color3.fromRGB(255, 255, 255)

    local function rgbString(color)
        return string.format("rgb(%d,%d,%d)", color.R*255, color.G*255, color.B*255)
    end

    local function getTargetName()
        if currentTarget then
            local char = currentTarget.Parent
            if char then
                local player = Players:GetPlayerFromCharacter(char)
                if player then
                    return player.DisplayName ~= "" and player.DisplayName or player.Name
                end
            end
        end
        return nil
    end

    game:GetService("RunService").RenderStepped:Connect(function()
        local lines = {}

        -- Title line
        local titleText = UIcfg['TitleText'] or 'Xanax'
        local subtitleText = UIcfg['SubtitleText'] or '@y52v'
        lines[#lines+1] = string.format('<font size="%d"><b><font color="%s">%s</font></b> <font color="%s">%s</font></font>',
            titleSize, rgbString(titleColor), titleText, rgbString(subtitleColor), subtitleText)

        -- Active features line (only if ShowActiveFeatures is true)
        if UIcfg['ShowActiveFeatures'] ~= false then
            local parts = {}
            local function addPart(text, condition)
                if condition then
                    parts[#parts+1] = string.format('<font color="%s">%s</font>', rgbString(statusColor), text)
                end
            end

            addPart("Silent", Config['Silent Aim']['Enabled'] and isLocking and currentTarget)
            addPart("Trigger", Config['Trigger Bot']['Enabled'] and triggerEnabled)
            addPart("Assist", Config['Camera Lock']['Enabled'] and aimAssistEnabled)
            addPart("ESP", Config['Visual Awareness']['Enabled'])
            addPart("Speed", Config['Speed']['Enabled'] and SpeedEnabled)
            addPart("Inf", Config['Infinite Range']['Enabled'] and infRangeActive)
            addPart("NoDelay", Config['WeaponMods']['NoFireDelay']['Enabled'])

            if #parts > 0 then
                -- separate with separator
                local sep = string.format('<font color="%s"> | </font>', rgbString(sepColor))
                lines[#lines+1] = table.concat(parts, sep)
            end
        end

        -- Target name line
        if UIcfg['ShowTarget'] ~= false then
            local displayTarget = getTargetName()
            if displayTarget then
                lines[#lines+1] = string.format('<font color="%s">@</font><font color="%s">%s</font>',
                    rgbString(subtitleColor), rgbString(targetColor), displayTarget)
            end
        end

        text.Text = table.concat(lines, "\n")
    end)
end
