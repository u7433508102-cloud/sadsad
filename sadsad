-- TRIGGER BOT
-- ══════════════════════════════════════════════════════════════
local function TriggerBot()
    if not Config.TriggerBot.Enabled then return end
    if not triggerEnabled then return end
    if tick()-lastTriggerClick < Config.TriggerBot.Delay then return end
    local tp = Mouse.Target
    if not tp then return end
    local ch = tp:FindFirstAncestorOfClass("Model")
    if not ch then return end
    local pl = Players:GetPlayerFromCharacter(ch)
    if not pl or pl == LocalPlayer then return end
    if isPlayerKnockedOrKO(pl) then return end
    if not canSeeTarget(tp) then return end
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    if Config.TriggerBot.SpecificWeapons.Enabled then
        local ok2 = false
        for _, w in pairs(Config.TriggerBot.SpecificWeapons.Weapons) do
            local cn = w:gsub("%[",""):gsub("%]","")
            if tool.Name == w or tool.Name:find(cn) then ok2=true; break end
        end
        if not ok2 then return end
    end
    tool:Activate()
    lastTriggerClick = tick()
end

