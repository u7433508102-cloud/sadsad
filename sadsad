    if silentFovCircle then pcall(function() silentFovCircle:Remove() end); silentFovCircle = nil end
    if camlockFovCircle then pcall(function() camlockFovCircle:Remove() end); camlockFovCircle = nil end
    if snaplineDrawing then pcall(function() snaplineDrawing:Remove() end); snaplineDrawing = nil end
    for _, esp in pairs(espData) do
        for _, d in pairs({esp.nameTag, esp.Distance, esp.Weapon, esp.Flag, esp.HeadDot, esp.HeadDotOutline}) do
            pcall(function() d:Remove() end)
        end
        for _, l in pairs(esp.BoxLines) do pcall(function() l:Remove() end) end
        for _, l in pairs(esp.BoxOutlines) do pcall(function() l:Remove() end) end
        for _, l in pairs(esp.CornerLines) do pcall(function() l:Remove() end) end
        for _, l in pairs(esp.CornerOutlines) do pcall(function() l:Remove() end) end
        for _, l in pairs(esp.dynLines) do pcall(function() l:Remove() end) end
    end
    espData = {}
    for _, cache in pairs(skeletonCache) do
        for _, l in pairs(cache.lines) do pcall(function() l:Remove() end) end
        for _, j in pairs(cache.joints) do pcall(function() j:Remove() end) end
    end
    skeletonCache = {}
    for _, a in pairs(arrowDrawings) do pcall(function() a:Remove() end) end
    arrowDrawings = {}
    for _, cache in pairs(ChamsCache) do
        for _, h in pairs(cache) do pcall(function() h:Destroy() end) end
    end
    ChamsCache = {}
    for _, c in pairs(game.CoreGui:GetChildren()) do
        if c.Name == "XanaxUI" then pcall(function() c:Destroy() end) end
    end
    shared.__XANAX_RUNNING = false
    shared.__XANAX_UNLOAD = nil
end

shared.__XANAX_RUNNING = true

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer and p.Character then pcall(addESPToPlayer, p) end
end
