local function addESPToPlayer(player)
    if player == LocalPlayer then return end
    if espData[player.UserId] then return end

    local esp = {
        player = player,
        nameTag  = newText(),
        Distance = newText(),
        Weapon   = newText(),
        Flag     = newText(),
        HeadDot  = newCircle(),
        HeadDotOutline = newCircle(),
        BoxLines     = {},
        BoxOutlines  = {},
        CornerLines  = {},
        CornerOutlines = {},
        dynState = { x = 0, y = 0, w = 0, h = 0, init = false },
        dynLines = { top = newLine(), bottom = newLine(), left = newLine(), right = newLine() },
    }

    esp.nameTag.Size = 13
    esp.nameTag.Color = Config.ESP.Names.Color
    esp.Distance.Size = 12
    esp.Distance.Color = Config.ESP.Distance.Color
    esp.Weapon.Size = 12
    esp.Weapon.Color = Config.ESP.Weapon.Color
    esp.Flag.Size = 11
    esp.Flag.Color = Color3.fromRGB(255,90,90)
    esp.Flag.Center = false
    esp.HeadDot.Radius = 4
    esp.HeadDot.Filled = true
    esp.HeadDotOutline.Radius = 6
    esp.HeadDotOutline.Thickness = 1.5

    for i=1,ESP_BOX_LINES do
        esp.BoxLines[i] = newLine()
        esp.BoxOutlines[i] = newLine()
    end
    for i=1,ESP_CORNER_LINES do
        esp.CornerLines[i] = newLine()
        esp.CornerOutlines[i] = newLine()
    end

    if Config.ESP.Chams and Config.ESP.Chams.Enabled then ChamsCache[player] = {} end
    espData[player.UserId] = esp

    if Config.SkeletonESP.Enabled then
        local lines, joints = {}, {}
        for i=1,20 do
            local l = newLine(); l.Thickness = Config.SkeletonESP.Thickness
            l.Color = Config.SkeletonESP.Color
            l.Transparency = 1-(Config.SkeletonESP.Transparency or 0)
            lines[i] = l
        end
        for i=1,20 do
            local j = newCircle(); j.Radius = 2; j.Filled = true
            j.Color = Config.SkeletonESP.Color
            joints[i] = j
        end
        skeletonCache[player] = {lines=lines, joints=joints}
    end
end

local function removeESPFromPlayer(player)
    local esp = espData[player.UserId]
    if esp then
        for _,d in pairs({esp.nameTag, esp.Distance, esp.Weapon, esp.Flag, esp.HeadDot, esp.HeadDotOutline}) do
            pcall(function() d:Remove() end)
        end
        for _,l in pairs(esp.BoxLines) do pcall(function() l:Remove() end) end
        for _,l in pairs(esp.BoxOutlines) do pcall(function() l:Remove() end) end
        for _,l in pairs(esp.CornerLines) do pcall(function() l:Remove() end) end
        for _,l in pairs(esp.CornerOutlines) do pcall(function() l:Remove() end) end
        for _,l in pairs(esp.dynLines) do pcall(function() l:Remove() end) end
        espData[player.UserId] = nil
    end
    if skeletonCache[player] then
        for _,l in pairs(skeletonCache[player].lines) do pcall(function() l:Remove() end) end
        for _,j in pairs(skeletonCache[player].joints) do pcall(function() j:Remove() end) end
        skeletonCache[player]=nil
    end
    if arrowDrawings[player] then
        pcall(function() arrowDrawings[player]:Remove() end)
        arrowDrawings[player]=nil
    end
    if ChamsCache[player] then
        for _,h in pairs(ChamsCache[player]) do pcall(function() h:Destroy() end) end
        ChamsCache[player]=nil
    end
end

local function hideESP(esp)
    esp.nameTag.Visible = false
    esp.Distance.Visible = false
    esp.Weapon.Visible = false
    esp.Flag.Visible = false
    esp.HeadDot.Visible = false
    esp.HeadDotOutline.Visible = false
    for i=1,ESP_BOX_LINES do
        esp.BoxLines[i].Visible = false
        esp.BoxOutlines[i].Visible = false
    end
    for i=1,ESP_CORNER_LINES do
        esp.CornerLines[i].Visible = false
        esp.CornerOutlines[i].Visible = false
    end
    for _,l in pairs(esp.dynLines) do l.Visible = false end
end

local function getCharacterBounds(char)
    local minY, maxY = math.huge, -math.huge
    local centerX, centerZ, count = 0, 0, 0
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
            local y = part.Position.Y
            if y < minY then minY = y end
            if y > maxY then maxY = y end
            centerX = centerX + part.Position.X
            centerZ = centerZ + part.Position.Z
            count = count + 1
        end
    end
    if count == 0 then return nil end
    return minY, maxY, centerX/count, centerZ/count
end

local function refreshESP()
    if not Config.ESP.Enabled then
        for _, esp in pairs(espData) do hideESP(esp) end
        return
    end

    for userId, esp in pairs(espData) do
        local player = esp.player
        local char = player and player.Character

        if not player or not player.Parent or not char
            or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Head") then
            hideESP(esp)
            if skeletonCache[player] then
                for _,l in pairs(skeletonCache[player].lines) do l.Visible=false end
                for _,j in pairs(skeletonCache[player].joints) do j.Visible=false end
            end
            if arrowDrawings[player] then arrowDrawings[player].Visible=false end
            goto continue
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            hideESP(esp)
            if skeletonCache[player] then
                for _,l in pairs(skeletonCache[player].lines) do l.Visible=false end
                for _,j in pairs(skeletonCache[player].joints) do j.Visible=false end
            end
            if arrowDrawings[player] then arrowDrawings[player].Visible=false end
            goto continue
        end

        if Config.ESP.Chams.Enabled then
            if not ChamsCache[player] then ChamsCache[player] = {} end
            local col = Config.ESP.Chams.Color
            local trans = Config.ESP.Chams.Transparency
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    local h = ChamsCache[player][part]
                    if not h then
                        h = Instance.new("Highlight")
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.FillTransparency = 1
                        h.OutlineTransparency = trans
                        h.Adornee = part
                        h.Parent = part
                        ChamsCache[player][part] = h
                    end
                    h.OutlineColor = col; h.FillColor = col; h.OutlineTransparency = trans
                end
            end
        elseif ChamsCache[player] then
            for _,h in pairs(ChamsCache[player]) do pcall(function() h:Destroy() end) end
            ChamsCache[player] = nil
        end

        local rootPart = char.HumanoidRootPart
        local head = char.Head

        local headPos, headOn = Camera:WorldToViewportPoint(head.Position)
        local minY, maxY, cx, cz = getCharacterBounds(char)
        if not minY then goto continue end

        local feetWorld = Vector3.new(cx, minY, cz)
        local topWorld  = Vector3.new(cx, maxY + 0.15, cz)
        local feetPos, feetOn = Camera:WorldToViewportPoint(feetWorld)
        local topPos, topOn   = Camera:WorldToViewportPoint(topWorld)

        if not feetOn or not topOn or not headOn or feetPos.Z <= 0 or topPos.Z <= 0 then
            hideESP(esp)
            if skeletonCache[player] then
                for _,l in pairs(skeletonCache[player].lines) do l.Visible=false end
                for _,j in pairs(skeletonCache[player].joints) do j.Visible=false end
            end
            if arrowDrawings[player] then arrowDrawings[player].Visible=false end
            goto continue
        end

        if arrowDrawings[player] then arrowDrawings[player].Visible=false end

        local boxCfg = Config.ESP.Boxes
        local topY = math.min(topPos.Y, feetPos.Y)
        local botY = math.max(topPos.Y, feetPos.Y)
        local boxH = botY - topY
        local boxW = boxH / 2
        local cxScreen = (feetPos.X + topPos.X) / 2
        local bx = cxScreen - boxW / 2
        local by = topY

        local boxColor = boxCfg.Color
        local t = boxCfg.Thickness
        local hasOutline = boxCfg.Outlines and boxCfg.Outlines.Style ~= "None"
        local oColor = boxCfg.Outlines and boxCfg.Outlines.Color or Color3.fromRGB(0,0,0)
        local oThickness = boxCfg.Outlines and boxCfg.Outlines.Thickness or 1

        local boxType = boxCfg.BoxType or "Normal"

        if boxType == "Dynamic" then
            for i=1,ESP_BOX_LINES do esp.BoxLines[i].Visible=false; esp.BoxOutlines[i].Visible=false end
            for i=1,ESP_CORNER_LINES do esp.CornerLines[i].Visible=false; esp.CornerOutlines[i].Visible=false end
        else
            for _,l in pairs(esp.dynLines) do l.Visible=false end
        end

        if boxType == "Normal" then
            local x1, y1 = bx, by
            local x2, y2 = bx + boxW, by + boxH

            local function setLine(l, x1_, y1_, x2_, y2_, col, thick, vis)
                l.From = Vector2.new(x1_, y1_)
                l.To   = Vector2.new(x2_, y2_)
                l.Color = col
                l.Thickness = thick
                l.Transparency = 1
                l.Visible = vis
            end

            if hasOutline then
                setLine(esp.BoxOutlines[1], x1-oThickness, y1-oThickness, x2+oThickness, y1-oThickness, oColor, t+oThickness*2, true)
                setLine(esp.BoxOutlines[2], x1-oThickness, y2+oThickness, x2+oThickness, y2+oThickness, oColor, t+oThickness*2, true)
                setLine(esp.BoxOutlines[3], x1-oThickness, y1-oThickness, x1-oThickness, y2+oThickness, oColor, t+oThickness*2, true)
                setLine(esp.BoxOutlines[4], x2+oThickness, y1-oThickness, x2+oThickness, y2+oThickness, oColor, t+oThickness*2, true)
            else
                for i=1,4 do esp.BoxOutlines[i].Visible=false end
            end

            setLine(esp.BoxLines[1], x1, y1, x2, y1, boxColor, t, true)
            setLine(esp.BoxLines[2], x1, y2, x2, y2, boxColor, t, true)
            setLine(esp.BoxLines[3], x1, y1, x1, y2, boxColor, t, true)
            setLine(esp.BoxLines[4], x2, y1, x2, y2, boxColor, t, true)

        elseif boxType == "Dynamic" then
            local targetX, targetY, targetW, targetH = bx, by, boxW, boxH
            local s = esp.dynState
            if not s.init then
                s.x = targetX; s.y = targetY; s.w = targetW; s.h = targetH; s.init = true
            else
                local lerp = boxCfg.Smoothing or 0.15
                s.x = s.x + (targetX - s.x) * lerp
                s.y = s.y + (targetY - s.y) * lerp
                s.w = s.w + (targetW - s.w) * lerp
                s.h = s.h + (targetH - s.h) * lerp
            end
            local x1, y1 = s.x, s.y
            local x2, y2 = s.x + s.w, s.y + s.h

            local function setDyn(l, x1_, y1_, x2_, y2_, col, thick)
                l.From = Vector2.new(x1_, y1_)
                l.To   = Vector2.new(x2_, y2_)
                l.Color = col
                l.Thickness = thick
                l.Transparency = 1
                l.Visible = true
            end

            if hasOutline then
                setDyn(esp.dynLines.top,    x1-oThickness, y1-oThickness, x2+oThickness, y1-oThickness, oColor, t+oThickness*2)
                setDyn(esp.dynLines.bottom, x1-oThickness, y2+oThickness, x2+oThickness, y2+oThickness, oColor, t+oThickness*2)
                setDyn(esp.dynLines.left,   x1-oThickness, y1-oThickness, x1-oThickness, y2+oThickness, oColor, t+oThickness*2)
                setDyn(esp.dynLines.right,  x2+oThickness, y1-oThickness, x2+oThickness, y2+oThickness, oColor, t+oThickness*2)
            end

            local dcol = boxColor
            esp.dynLines.top.From    = Vector2.new(x1, y1)
            esp.dynLines.top.To      = Vector2.new(x2, y1)
            esp.dynLines.top.Color   = dcol
            esp.dynLines.top.Thickness = t
            esp.dynLines.top.Visible = true

            esp.dynLines.bottom.From = Vector2.new(x1, y2)
            esp.dynLines.bottom.To   = Vector2.new(x2, y2)
            esp.dynLines.bottom.Color = dcol
            esp.dynLines.bottom.Thickness = t
            esp.dynLines.bottom.Visible = true

            esp.dynLines.left.From   = Vector2.new(x1, y1)
            esp.dynLines.left.To     = Vector2.new(x1, y2)
            esp.dynLines.left.Color  = dcol
            esp.dynLines.left.Thickness = t
            esp.dynLines.left.Visible = true

            esp.dynLines.right.From  = Vector2.new(x2, y1)
            esp.dynLines.right.To    = Vector2.new(x2, y2)
            esp.dynLines.right.Color = dcol
            esp.dynLines.right.Thickness = t
            esp.dynLines.right.Visible = true
        end

        if Config.ESP.HeadDot then
            esp.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
            esp.HeadDot.Radius = math.max(2, boxH*0.05)
            esp.HeadDot.Color = boxColor
            esp.HeadDot.Visible = true
            esp.HeadDotOutline.Position = Vector2.new(headPos.X, headPos.Y)
            esp.HeadDotOutline.Radius = esp.HeadDot.Radius + 2
            esp.HeadDotOutline.Visible = true
        else
            esp.HeadDot.Visible = false
            esp.HeadDotOutline.Visible = false
        end

        if Config.ESP.Names.Enabled then
            esp.nameTag.Position = Vector2.new(cxScreen, by - 15)
            esp.nameTag.Text = player.DisplayName ~= "" and player.DisplayName or player.Name
            esp.nameTag.Color = (currentTarget and currentTarget.Parent == char)
                and Config.ESP.Names.TargetColor or Config.ESP.Names.Color
            esp.nameTag.Size = Config.ESP.Names.TextSize or 13
            esp.nameTag.Visible = true
        else
            esp.nameTag.Visible = false
        end

        if Config.ESP.Weapon.Enabled then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                esp.Weapon.Text = "["..tool.Name.."]"
                esp.Weapon.Position = Vector2.new(cxScreen, by + boxH + 6)
                esp.Weapon.Color = Config.ESP.Weapon.Color
                esp.Weapon.Visible = true
            else
                esp.Weapon.Visible = false
            end
        else
            esp.Weapon.Visible = false
        end

        if Config.ESP.Distance.Enabled then
            local dist = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
            esp.Distance.Text = dist.."m"
            esp.Distance.Position = Vector2.new(cxScreen, by + boxH + 20)
            esp.Distance.Color = Config.ESP.Distance.Color
            esp.Distance.Visible = true
        else
            esp.Distance.Visible = false
        end

        if Config.ESP.Flags.Enabled then
            local flags = {}
            local be = char:FindFirstChild("BodyEffects")
            if be then local ko = be:FindFirstChild("K.O"); if ko and ko.Value then table.insert(flags,"KO") end end
            if hum.FloorMaterial == Enum.Material.Air then table.insert(flags,"AIR") end
            if #flags > 0 then
                esp.Flag.Text = table.concat(flags, " ")
                esp.Flag.Position = Vector2.new(bx + boxW + 5, by)
                esp.Flag.Visible = true
            else
                esp.Flag.Visible = false
            end
        else
            esp.Flag.Visible = false
        end

        ::continue::
    end
end

